ngSoon\":\"Expiring Soon\",\"expired\":\"Expired\",\"providerBreakdown\":\"Provider Breakdown\",\"newThisWeek\":\"new this week\",\"total\":\"Total\",\"recentIntegrations\":\"Recent Integrations\",\"noCalendarIntegrationData\":\"No calendar integration data available\",\"noIntegrationsFound\":\"No calendar integrations found\",\"noRecentIntegrations\":\"No recent integrations\"},\"aiMessage\":{\"copyLink\":\"Copy link\",\"copied\":\"Copied!\"},\"landingHeader\":{\"features\":\"Features\",\"howItWorks\":\"How It Works\",\"pricing\":\"Pricing\",\"roadmap\":\"Roadmap\",\"support\":\"Support\",\"signIn\":\"Sign In\",\"getLifetime\":\"Get Lifetime $27\"},\"landingHero\":{\"headline\":\"The Calendly Alternative\",\"subheadlinePart1\":\"With\",\"subheadlineHighlight\":\"AI Agent\",\"subheadlinePart2\":\"Built-In\",\"priceLifetime\":\"$$27 Lifetime\",\"discount\":\"70% OFF\",\"descriptionPart1\":\"All the scheduling features you need, plus an\",\"descriptionHighlight\":\"AI that creates meetings by voice\",\"descriptionPart2\":\"One payment, yours forever.\",\"valueProp1\":\"AI Agent creates events via voice or text\",\"valueProp2\":\"Free lifetime upgrades included\",\"valueProp3\":\"Save $600+ over 5 years vs Calendly\",\"valueProp4\":\"Lock in $27 (reg. $97) before deal ends\",\"primaryCta\":\"Claim My Lifetime Spot → $27\",\"secondaryCta\":\"Try Free for 7 Days\",\"trust1\":\"One-time payment, not subscription\",\"trust2\":\"30-day money-back guarantee\",\"trust3\":\"All future features included free\",\"urgency\":\"Limited lifetime licenses available. Price increases without notice.\",\"integrationsLabel\":\"Works with your favorite tools\"},\"landingFeatures\":{\"sectionTitle\":\"One platform.\",\"sectionTitleHighlight\":\"Every tool you need.\",\"sectionSubtitle\":\"CalendarJet replaces your entire scheduling stack. Stop paying for 4 different tools.\",\"replaces\":\"REPLACES\",\"aiScheduling\":{\"title\":\"AI Scheduling\",\"subtitle\":\"Schedule meetings with natural language\",\"speed\":\"3x faster\",\"feature1\":\"Voice commands\",\"feature2\":\"Smart suggestions\",\"feature3\":\"Auto-conflict detection\",\"feature4\":\"Natural language input\",\"feature5\":\"Multi-timezone support\",\"feature6\":\"Intelligent rescheduling\"},\"unifiedCalendar\":{\"title\":\"Unified Calendar\",\"subtitle\":\"Sync all your calendars in one place\",\"feature1\":\"Google Calendar\",\"feature2\":\"Apple Calendar\",\"feature3\":\"Outlook sync\",\"feature4\":\"2-way sync\",\"feature5\":\"Conflict resolution\",\"feature6\":\"Real-time updates\"},\"paymentCollection\":{\"title\":\"Payment Collection\",\"subtitle\":\"Get paid for your time automatically\",\"speed\":\"0% extra fees\",\"feature1\":\"Stripe integration\",\"feature2\":\"Auto-invoicing\",\"feature3\":\"Deposit collection\",\"feature4\":\"Refund handling\",\"feature5\":\"Multiple currencies\",\"feature6\":\"Tax compliance\"},\"teamScheduling\":{\"title\":\"Team Scheduling\",\"subtitle\":\"Coordinate across your entire team\",\"feature1\":\"Round-robin booking\",\"feature2\":\"Collective availability\",\"feature3\":\"Resource allocation\",\"feature4\":\"Team calendars\",\"feature5\":\"Role permissions\",\"feature6\":\"Analytics dashboard\"}},\"landingFooter\":{\"ctaBadge\":\"Join 1,000+ professionals\",\"ctaTitlePart1\":\"Ready to automate your\",\"ctaTitleHighlight\":\"scheduling?\",\"ctaDescription\":\"Stop wasting time on back-and-forth emails. Let your clients book meetings instantly.\",\"ctaButton\":\"Start Free Trial\",\"noCreditCard\":\"No credit card required\",\"freeTrial\":\"Free 14-day trial\",\"setupTime\":\"Setup in 2 minutes\",\"cancelAnytime\":\"Cancel anytime\",\"tagline\":\"AI-powered scheduling that eliminates back-and-forth emails. Book meetings in seconds, not hours.\",\"stayInLoop\":\"Stay in the loop\",\"onTheList\":\"You're on the list!\",\"emailPlaceholder\":\"Enter your email\",\"subscribe\":\"Subscribe\",\"product\":\"Product\",\"features\":\"Features\",\"pricing\":\"Pricing\",\"roadmap\":\"Roadmap\",\"apiDocs\":\"API Docs\",\"resources\":\"Resources\",\"signIn\":\"Sign In\",\"getStarted\":\"Get Started\",\"dashboard\":\"Dashboard\",\"support\":\"Support\",\"contactUs\":\"Contact Us\",\"legal\":\"Legal\",\"privacyPolicy\":\"Privacy Policy\",\"termsOfService\":\"Terms of Service\",\"security\":\"Security\",\"dataDeletion\":\"Data Deletion\",\"company\":\"Company\",\"verifiedLLC\":\"Verified LLC\",\"madeWith\":\"Made with\",\"inAustin\":\"in Austin, TX\",\"privacy\":\"Privacy\",\"terms\":\"Terms\",\"securityLink\":\"Security\",\"status\":\"Status\",\"trademarkNotice\":\"Calendly, Cal.com, Acuity, and other product names mentioned are trademarks of their respective owners. CalendarJet is not affiliated with these companies.\"},\"landingFAQ\":{\"titlePart1\":\"Frequently Asked\",\"titlePart2\":\"Questions\",\"subtitle\":\"Got questions? We've got answers.\",\"gotQuestions\":\"Got Questions?\",\"q1Question\":\"How much does CalendarJet cost?\",\"q1Answer\":\"CalendarJet is currently 70% OFF! The regular price is $97, but right now you can get lifetime access for just $27. This is a one-time payment - no monthly fees, ever. All features included, plus free updates forever. We also offer a 7-day free trial with no credit card required.\",\"q2Question\":\"How does CalendarJet work?\",\"q2Answer\":\"CalendarJet syncs with your existing calendars (Google, Apple) to show your real-time availability. Share your booking link, and clients can instantly book available time slots without any back-and-forth emails.\",\"q3Question\":\"Is this truly a lifetime deal?\",\"q3Answer\":\"Yes, it's a true lifetime deal! The regular price is $97, but you're getting it for $27 (70% OFF). Once you join, you'll have full access to CalendarJet for as long as the platform exists. And to give you complete peace of mind, if we ever discontinue the service in the future, we'll share the full source code along with a step-by-step guide so you can host it yourself. That's our commitment to making this truly lifetime.\",\"q4Question\":\"Is there a free trial?\",\"q4Answer\":\"Yes! We offer a 7-day free trial with full access to all features. No credit card required to start. Try everything CalendarJet has to offer before you decide.\",\"q5Question\":\"What calendars does CalendarJet support?\",\"q5Answer\":\"CalendarJet integrates with Google Calendar and Apple Calendar (iCloud). You can connect multiple calendars to prevent double-bookings.\",\"q6Question\":\"Can I customize my booking page?\",\"q6Answer\":\"Yes! You can fully customize your booking pages with custom colors, logos, and our visual page builder to match your brand.\",\"q7Question\":\"How does team scheduling work?\",\"q7Answer\":\"Team scheduling allows multiple team members to share a booking link. You can choose round-robin (distribute evenly), collective (all must attend), or pooled scheduling based on your needs.\",\"q8Question\":\"How many AI commands can I use?\",\"q8Answer\":\"Free trial users get 3 AI commands per day (90/month). Lifetime Pro users get 50 AI commands per day (1,500/month). Limits reset daily at midnight UTC. The AI can understand natural language like \\\"Block next Friday\\\" or \\\"Set my availability to weekdays 9-5\\\".\"},\"landingPricing\":{\"dealBadge\":\"LIFETIME DEAL · Limited Time Only\",\"titlePart1\":\"Pay Once.\",\"titlePart2\":\"Own Forever.\",\"subtitlePart1\":\"No subscriptions. No monthly fees. Just\",\"subtitlePart2\":\"for lifetime access to everything.\",\"guaranteeText\":\"30-day money-back guarantee • All features included • Free updates forever\",\"freeName\":\"Free Forever\",\"freeDescription\":\"Perfect for individuals getting started\",\"free1\":\"1 Event Type\",\"free2\":\"Unlimited bookings\",\"free3\":\"Basic calendar integrations\",\"free4\":\"Email notifications\",\"free5\":\"Mobile responsive pages\",\"free6\":\"Community support\",\"freeCta\":\"Start Free\",\"lifetimeName\":\"Lifetime Access\",\"life