...\"},\"cancelBooking\":{\"title\":\"Cancel Booking\",\"subtitle\":\"We're sorry to see you cancel\",\"reasonLabel\":\"Reason for cancellation\",\"placeholder\":\"Please let us know why you're cancelling...\",\"reasons\":{\"scheduleConflict\":\"Schedule conflict\",\"noLongerNeeded\":\"No longer needed\",\"foundAlternative\":\"Found alternative solution\",\"other\":\"Other reason\"},\"aiHelp\":\"Need help explaining?\",\"aiWriting\":\"AI is writing...\",\"keepBooking\":\"Keep Booking\",\"cancelBookingButton\":\"Cancel Booking\",\"cancelling\":\"Cancelling...\"},\"declineBooking\":{\"title\":\"Decline Booking Request\",\"defaultMeeting\":\"Default Meeting\",\"reasonLabel\":\"Reason for declining\",\"reasons\":{\"notAvailable\":\"Not available at requested time\",\"outsideScope\":\"Outside my scope of work\",\"fullyBooked\":\"Fully booked\",\"notGoodFit\":\"Not a good fit\",\"other\":\"Other reason\"},\"messageLabel\":\"Message to invitee (optional)\",\"messagePlaceholder\":\"Explain why you're declining and suggest alternatives...\",\"notifyLabel\":\"Notify invitee\",\"notifyDescription\":\"Send an email with your decline reason\",\"cancelButton\":\"Cancel\",\"declineButton\":\"Decline Booking\",\"declining\":\"Declining...\",\"errors\":{\"failedToDecline\":\"Failed to decline booking\",\"tryAgain\":\"Please try again\"}}},\"upgradeModal\":{\"title\":\"Unlock Pro Features\",\"subtitle\":\"Get lifetime access to all features\",\"pricing\":{\"oneTime\":\"One-time payment\",\"amount\":\"$$27\",\"noRecurring\":\"No recurring fees, ever\"},\"features\":{\"unlimitedEvents\":{\"title\":\"Unlimited Event Types\",\"description\":\"Create as many booking types as you need\"},\"customBranding\":{\"title\":\"Custom Branding\",\"description\":\"White-label your booking pages with your logo\"},\"teamScheduling\":{\"title\":\"Team Scheduling\",\"description\":\"Round-robin and priority-based assignments\"},\"payments\":{\"title\":\"Payment Processing\",\"description\":\"Accept Stri