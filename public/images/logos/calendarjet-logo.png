onnectFailed\":\"Failed to disconnect. Please try again.\",\"disconnectError\":\"Error disconnecting Google Calendar. Please try again.\"},\"status\":{\"checking\":\"Checking connection status...\",\"connected\":\"Connected to Google Calendar\",\"connectedSuccess\":\"Successfully connected! Your calendar will now sync automatically.\",\"notConnected\":\"Not connected\"},\"buttons\":{\"connect\":\"Connect Google Calendar\",\"disconnect\":\"Disconnect\"},\"calendars\":{\"selectTitle\":\"Select Calendars to Check\",\"noSelection\":\"No calendars selected\",\"primary\":\"Primary\",\"saving\":\"Saving...\",\"selectedCount\":\"{count} calendar(s) selected\"},\"howItWorks\":{\"title\":\"How It Works:\",\"step1\":\"We check your selected calendars for conflicts\",\"step2\":\"Busy times are automatically blocked on your booking page\",\"step3\":\"New bookings are added to your primary calendar\",\"step4\":\"Changes sync in real-time\",\"step5\":\"Supports multiple calendars\"},\"whyConnect\":{\"title\":\"Why Connect Google Calendar?\",\"benefit1\":\"Prevent double bookings automatically\",\"benefit2\":\"Show real availability to clients\",\"benefit3\":\"Sync bookings to your calendar\",\"benefit4\":\"Check multiple calendars for conflicts\"},\"privacy\":{\"description\":\"We only access your calendar availability, not your event details.\",\"googlePermissions\":\"Google Calendar Permissions\",\"noteLabel\":\"Note:\",\"learnMore\":\"Learn more in our\",\"privacyPolicy\":\"Privacy Policy\"},\"termsAgreement\":{\"prefix\":\"By connecting, you agree to our\",\"terms\":\"Terms of Service\",\"and\":\"and\",\"privacyPolicy\":\"Privacy Policy\"},\"modal\":{\"disconnectTitle\":\"Disconnect Google Calendar?\",\"disconnectMessage\":\"This will remove your Google Calendar connection. Your bookings will no longer sync with your calendar.\",\"confirmDisconnect\":\"Yes, Disconnect\",\"cancel\":\"Cancel\"}},\"googleCalendarDesc\":\"Sync bookings, generate Meet links, and check conflicts with up to 3 accounts.\",\"appleCalendar\":{\"title\":\"Apple Calendar (iCloud)\",\"description\":\"Sync your Apple Calendar to prevent double bookings\",\"dismiss\":\"Dismiss\",\"appleIdLabel\":\"Apple ID\",\"errors\":{\"connectionFailed\":\"Connection failed. Please check your credentials.\",\"disconnectFailed\":\"Failed to disconnect. Please try again.\",\"disconnectError\":\"Error disconnecting Apple Calendar. Please try again.\",\"saveFailed\":\"Failed to save. Please try again.\",\"tryAgain\":\"An error occurred. Please try again.\"},\"status\":{\"checking\":\"Checking connection status...\",\"connected\":\"Connected to Apple Calendar\",\"connectedSuccess\":\"Successfully connected to Apple Calendar!\",\"notConnected\":\"Not connected\"},\"buttons\":{\"connect\":\"Connect Apple Calendar\",\"disconnect\":\"Disconnect\",\"testing\":\"Testing...\"},\"form\":{\"appleIdLabel\":\"Apple ID (Email)\",\"appleIdPlaceholder\":\"your@icloud.com\",\"appPasswordLabel\":\"App-Specific Password\",\"appPasswordPlaceholder\":\"xxxx-xxxx-xxxx-xxxx\",\"passwordFormat\":\"Format: xxxx-xxxx-xxxx-xxxx (16 characters with dashes)\"},\"setup\":{\"instructionsTitle\":\"How to Create an App-Specific Password:\",\"step1\":{\"prefix\":\"Go to\",\"linkText\":\"appleid.apple.com\"},\"step2\":\"Sign in with your Apple ID\",\"step6\":\"Under Security, click App-Specific Passwords\",\"step7\":\"Click Generate Password\",\"step8\":\"Copy the generated password and paste it above\",\"noteLabel\":\"Note:\",\"noteText\":\"App-specific passwords are required because Apple does not allow third-party apps to use your main password.\"},\"howItWorks\":{\"title\":\"How It Works:\",\"step1\":\"We check your iCloud calendar for conflicts\",\"step2\":\"Busy times are automatically blocked on your booking page\",\"step3\":\"New bookings are added to your iCloud calendar\",\"step4\":\"Changes sync automatically\",\"step5\":\"Works with all iCloud calendars\"},\"whyConnect\":{\"title\":\"Why Connect Apple Calendar?\",\"benefit1\":\"Prevent double bookings automatically\",\"benefit2\":\"Show real availability to clients\",\"benefit3\":\"Sync bookings to iCloud\",\"benefit4\":\"Check all your Apple devices\"},\"security\":{\"label\":\"Security\",\"description\":\"Your credentials are encrypted with AES-256 and stored securely. We only access calendar availability, not your personal data.\"},\"modal\":{\"disconnectConfirm\":\"Disconnect Apple Calendar? Your bookings will no longer sync with iCloud.\"}},\"appleCalendarDesc\":\"Connect your iCloud calendar for seamless Apple ecosystem integration.\",\"outlookCalendar\":\"Outlook Calendar\",\"outlookCalendarDesc\":\"Sync with Microsoft Outlook and Office 365 calendars.\",\"zoom\":{\"title\":\"Zoom\",\"description\":\"Auto-create Zoom meetings for your bookings\",\"notConnected\":\"Zoom Not Connected\",\"connected\":\"Zoom Connected\",\"connectButton\":\"Connect Zoom\",\"disconnectButton\":\"Disconnect\",\"reconnectButton\":\"Reconnect\",\"connectionType\":\"Connection Type\",\"serverToServer\":\"Server-to-Server (Recommended)\",\"oauth\":{\"title\":\"Connect with Zoom (One-Click)\",\"recommended\":\"Recommended\",\"pendingApproval\":\"Pending Zoom Approval\",\"description\":\"Sign in with your Zoom account to automatically create meetings for your bookings.\",\"benefit1\":\"One-click setup - no technical knowledge required\",\"benefit2\":\"Automatic token refresh - always stays connected\",\"benefit3\":\"Uses official Zoom OAuth flow\",\"unableToConnect\":\"Unable to generate OAuth URL. Please try again.\",\"pendingNote\":\"Note: Our Zoom app is pending marketplace approval. Use Server-to-Server setup below while we wait.\"},\"accountEmail\":\"Account Email\",\"status\":{\"checking\":\"Checking connection status...\",\"connected\":\"Connected to Zoom\",\"connectedSuccess\":\"Successfully connected to Zoom! Your bookings will now include Zoom meeting links.\"},\"active\":\"Active\",\"expired\":\"Expired - Reconnect Required\",\"c