    (function() {
      var DARK = "dark-mode";
      var LIGHT = "light-mode";
      var root = document.documentElement;

      // 1. Check forced-theme routes (highest priority, ignores user preference)
      var routes = {"/ai":"dark"};
      var path = window.location.pathname;
      var keys = Object.keys(routes);
      for (var i = 0; i < keys.length; i++) {
        var r = keys[i];
        if (path === r || path.indexOf(r + "/") === 0) {
          var theme = routes[r];
          root.classList.add(theme === "dark" ? DARK : LIGHT);
          root.classList.remove(theme === "dark" ? LIGHT : DARK);
          return;
        }
      }

      // 2. Fall back to user preference from localStorage
      var userDarkMode = localStorage["dark-mode-enabled"];
      if (userDarkMode === "true") {
        root.classList.add(DARK);
        root.classList.remove(LIGHT);
      } else if (userDarkMode === "false") {
        root.classList.add(LIGHT);
        root.classList.remove(DARK);
      }
      // 3. If neither, no classes — CSS @media prefers-color-scheme handles it
    })()
