erator\",\"aiEssayExpander\":\"AI Essay Expander\"},\"moreAiTools\":{\"label\":\"More AI Tools\",\"researchPaperSummarizer\":\"Research Paper Summarizer\",\"aiAbstractGenerator\":\"AI Abstract Generator\",\"essayTitleGenerator\":\"Essay Title Generator\",\"essayTopicGenerator\":\"Essay Topic Generator\",\"aiConclusionWriter\":\"AI Conclusion Writer\",\"articleSummarizer\":\"Article Summarizer\",\"essaySummarizer\":\"Essay Summarizer\",\"youtubeSummarizer\":\"Youtube Summarizer\",\"paragraphSummarizer\":\"Paragraph Summarizer\",\"sentenceSummarizer\":\"Sentence Summarizer\"},\"comparisons\":{\"label\":\"Comparisons\",\"paperguideVsPaperpile\":\"Paperguide Vs Paperpile\",\"paperguideVsScispace\":\"Paperguide Vs Scispace\",\"paperguideVsZotero\":\"Paperguide Vs Zotero\",\"paperguideVsMendeley\":\"Paperguide Vs Mendeley\",\"paperguideVsGoogleScholar\":\"Paperguide Vs Google Scholar\",\"paperguideVsJenniAi\":\"Paperguide vs Jenni AI\",\"paperguideVsAfforai\":\"Paperguide vs Afforai\",\"paperpileAlternatives\":\"Paperpile Alternatives\",\"consensusAlternatives\":\"Consensus Alternatives\",\"googleScholarAlternatives\":\"Google Scholar Alternatives\"},\"solutions\":{\"label\":\"Solutions\",\"healthEconomicsOutcomesResearch\":\"Health Economics \u0026 Outcomes Research\",\"systematicReviews\":\"Systematic Reviews\",\"clinicalTrials\":\"Clinical Trials\",\"academicResearchLiteratureReview\":\"Academic Research Literature Review\",\"drugDiscovery\":\"Drug Discovery\"}},\"social\":{\"twitter\":\"Twitter\",\"tiktok\":\"TikTok\",\"linkedin\":\"LinkedIn\",\"instagram\":\"Instagram\",\"youtube\":\"YouTube\",\"facebook\":\"Facebook\"}},\"dashboardSidebar\":{\"home\":\"Dashboard\",\"researchAssistant\":\"Research Assistant\",\"referenceManager\":\"Reference Manager\",\"aiWriter\":\"AI Writer\",\"aiSearch\":\"AI Search\",\"extractData\":\"Extract Data\",\"deepSearch\":\"Deep Research Report\",\"dashboardOld\":\"Dashboard (Old)\",\"historyOld\":\"History (Old)\",\"history\":\"History\",\"referAndEarn\":\"Refer \u0026 Earn\",\"support\":\"Support\",\"help\":{\"title\":\"Help\",\"joinDiscord\":\"Join Discord\",\"emailUs\":\"Email Us\",\"helpGuide\":\"Help Guide\",\"changelog\":\"Changelog\",\"roadmap\":\"Roadmap\"},\"dashboardNew\":\"Dashboard 2.0\",\"agent\":\"Agent\",\"searchPapers\":\"AI Search 2.0\",\"literatureReview\":\"Literature Review\",\"generateDocument\":\"Generate Document\",\"exploreAgents\":\"Explore Agents\",\"myChats\":\"My Chats\",\"myNotebooks\":\"My Notebooks\",\"myWorkbooks\":\"My Workbooks\",\"chatWithPdf\":\"Chat with PDF\",\"literatureReview2\":\"Literature Review 2.0\"},\"auth\":{\"signup\":{\"title\":\"Sign Up\",\"email\":\"Email\",\"password\":\"Password\",\"welcome\":\"Welcome to Paperguide 👋\",\"register\":\"Register\",\"haveAccount\":\"Have an existing account?\",\"login\":\"Login\",\"agreeToTerms\":\"By signing up, you agree to our\",\"and\":\"and\",\"terms\":\"Terms\",\"privacyPolicy\":\"Privacy policy\",\"clickHere\":\"Click here\",\"startExploringPaperguide\":\"Start exploring Paperguide!\",\"signUpWithGoogle\":\"Sign Up With Google\"},\"login\":{\"title\":\"Login\",\"email\":\"Email\",\"password\":\"Password\",\"subHeading\":\"Welcome Back. You were missed!\",\"loginWithGoogle\":\"Login with Google\",\"placeholderEmail\":\"Email\",\"placeholderPassword\":\"Password\",\"login\":\"Login\",\"forgotPassword\":\"Forgot Password?\",\"dontHaveAccount\":\"Don't have an account?\",\"register\":\"Register\",\"agreeToTerms\":\"By signing in, you agree to our\",\"and\":\"and\",\"terms\":\"Terms\",\"privacyPolicy\":\"Privacy policy\",\"clickHere\":\"Click here\",\"startExploringPaperguide\":\"Start exploring Paperguide!\"}},\"widget\":{\"greetingMessage\":\"Hello\",\"startWithResearchQuestion\":\"start with a research question\",\"widgetTabs\":{\"deepSearch\":\"Deep Research\",\"aiSearch\":\"AI Search\",\"literatureReview\":\"Literature Review\",\"chatWithPdf\":\"Chat with PDF\",\"extractData\":\"Extract Data\"},\"aiSearch\":{\"placeHolder\":\"Ask a question and get answers from 220 million research papers\",\"filter\":\"Filters\",\"tryTheseQuestions\":\"Try these questions\"},\"literatureReview\":{\"placeHolder\":\"Ask a research question, Conduct literature review, Find top research papers\",\"tryTheseQuestions\":\"Try these questions\"},\"chatWithPdf\":{\"heading\":{\"part1\":\"select\",\"part2\":\"or Drop files here\"},\"subHeading\":\"Up to 3 PDFs Only\",\"uploadUrl\":\"Upload URL\",\"references\":\"References\",\"toolTipMessage\":{\"part1\":\"To chat with more than 3 documents at a time, first add them to References or Library and you can initiate that chat directly by selecting papers.\",\"part2\":\"More details here\"}},\"extractData\":{\"heading\":{\"part1\":\"Select from\",\"part2\":\"My References\"},\"toolTipMessage\":\"To extract data, you need to upload papers or PDFs to your References (library) first\",\"selectPapersDescription\":\"Select papers from your reference manager to extract data from it's attached documents\",\"extractDataButton\":\"Extract Data\",\"recentHistory\":\"Recent extracted table history:\",\"edit\":\"Edit\",\"delete\":\"Delete\",\"noExtractionsYet\":\"No extractions yet. Select references to generate your first table.\"},\"uploadUrl\":{\"back\":\"Back\",\"heading\":\"Add URL or Youtube URL\",\"placeHolder\":\"Enter URL or Youtube URL\",\"create\":\"Create\"}},\"agent\":{\"startWithResearchQuestion\":\"start with a research question\",\"askQuestionsGetAnswers\":\"Ask questions. Get answers from your documents!\",\"askTheResearch\":\"Ask the research...\",\"trySearching\":\"Try searching..\",\"exploreQuestions\":\"Explore sample research questions\",\"sampleCategories\":{\"clinicalMedicine\":{\"title\":\"Clinical Medicine\",\"q1\":\"Are GLP-1 receptor agonists effective and safe for long-term weight loss?\",\"q2\":\"Does metformin reduce progression from prediabetes to type 2 diabetes in real-world studies?\",\"q3\":\"Is early physical therapy effective for reducing pain and disability in low back pain?\",\"q4\":\"Are proton pump inhibitors associated with increased risk of kidney disease?\",\"q5\":\"What is the comparative effectiveness of CBT vs SSRIs for generalized anxiety disorder?\"},\"healthcare\":{\"title\":\"Healthcare\",\"q1\":\"Does long-term PM2.5 exposure increase risk of dementia?\",\"q2\":\"Do ultra-processed foods increase risk of cardiovascular disease?\",\"q3\":\"What is the association between heat exposure and cardiovascular mortality among outdoor workers?\",\"q4\":\"Does night shift work increase risk of type 2 diabetes and metabolic syndrome?\",\"q5\":\"How strongly is alcohol consumption linked to all-cause mortality across dose ranges?\"},\"environment\":{\"title\":\"Environment\",\"q1\":\"What is the association between long-term PM2.5 exposure and cardiovascular mortality?\",\"q2\":\"How does climate change affect the frequency and intensity of heatwaves globally?\",\"q3\":\"Do microplastics in drinking water pose measurable risks to human health?\",\"q4\":\"How effective is carbon capture and storage at reducing industrial CO2 emissions at scale?\",\"q5\":\"What are the biodiversity impacts of renewable energy expansion (wind/solar) on local ecosystems?\"},\"technology\":{\"title\":\"Technology\",\"q1\":\"How reliable are common LLM evaluation benchmarks at predicting real-world performance?\",\"q2\":\"How accurate are AI models for detecting breast cancer on mammography?\",\"q3\":\"Do wearables reliably detect atrial fibrillation compared to clinical ECG?\",\"q4\":\"What techniques best reduce hallucinations in medical or scientific LLM outputs?\"},\"fitnessNutrition\":{\"title\":\"Fitness \u0026 Nutrition\",\"q1\":\"Do ultra-processed foods increase risk of cardiovascular disease and mortality?\",\"q2\":\"Is intermittent fasting more effective than daily calorie restriction for fat loss and metabolic health?\",\"q3\":\"Does resistance training reduce depression and anxiety symptoms compared to no exercise?\",\"q4\":\"How does sleep duration and quality affect body composition and appetite regulation?\",\"q5\":\"Are plant-based diets associated with lower risk of type 2 diabetes and heart disease?\"}},\"myChats\":\"My Chats\",\"newChat\":\"New Chat\",\"searchYourChats\":\"Search your chats...\",\"filterAll\":\"All\",\"filterSearch\":\"Search\",\"filterChatWithPdf\":\"Chat with PDF\",\"filterDeepSearch\":\"Deep Research\",\"completedStatus\":\"Completed\",\"inProgressStatus\":\"In Progress\",\"untitledChat\":\"Untitled Chat\",\"researchPapers\":\"Research Papers\",\"outputs\":\"Outputs\",\"share\":\"Share\",\"shareThisChat\":\"Share this chat\",\"noAgentHistoryFound\":\"No agent history found\",\"failedToLoadAgentHistory\":\"Failed to load agent history\",\"chatUpdatedSuccessfully\":\"Chat updated successfully\",\"chatDeletedSuccessfully\":\"Chat deleted successfully\",\"deleteAgentChat\":\"Delete Agent Chat\",\"deleteConfirmation\":\"Are you sure you want to delete\",\"deleteWarning\":\"? This action cannot be undone.\",\"delete\":\"Delete\",\"editChat\":\"Edit Chat\",\"updateChatName\":\"Update the name of your chat\",\"enterChatName\":\"Enter chat name\",\"saveChanges\":\"Save Changes\",\"close\":\"Close\",\"references\":\"References\",\"workbookAlreadyCreated\":\"Workbook already created\",\"notOwnerOfChat\":\"You are not the owner of this chat\",\"saveReferencesAsWorkbook\":\"Save this references table to your Notebooks to customize fields, manage papers, and extract data\",\"saving\":\"Saving...\",\"checking\":\"Checking...\",\"saved\":\"Saved\",\"saveAndEdit\":\"Save table\",\"listView\":\"List view\",\"tableView\":\"Table view\",\"findingPapers\":\"Our Agent is finding best papers for your research...\",\"papers\":\"Papers\",\"insights\":\"Insights\",\"noPapersFound\":\"No papers found\",\"noInsightAvailable\":\"No insight available\",\"noActiveAnswer\":\"No active answer to create literature review\",\"literatureReviewCreated\":\"Literature review created successfully\",\"failedToCreateLiteratureReview\":\"Failed to create literature review\",\"myNotebooks\":\"My Notebooks\",\"myWorkbooks\":\"My Workbooks\",\"newWorkbook\":\"New Workbook\",\"searchYourNotebooks\":\"Search your notebooks...\",\"searchYourWorkbooks\":\"Search your workbooks..\",\"all\":\"All\",\"documents\":\"Documents\",\"tables\":\"Tables\",\"noDocumentsFound\":\"No documents found\",\"untitledDocument\":\"Untitled Document\",\"untitledWorkbook\":\"Untitled Workbook\",\"noWorkbooksFound\":\"No workbooks found\",\"failedToLoadWorkbooks\":\"Failed to load workbooks\",\"workbookDeletedSuccessfully\":\"Workbook deleted successfully\",\"failedToDeleteWorkbook\":\"Failed to delete workbook\",\"deleteWorkbook\":\"Delete Workbook\",\"deleteWorkbookConfirmation\":\"Are you sure you want to delete\",\"deleteWorkbookWarning\":\"? This action cannot be undone.\",\"export\":\"Export\",\"exportPapers\":\"Export papers\",\"noPapersToExport\":\"No papers to export\",\"subscribeToExport\":\"Subscribe to export papers\",\"upgradeToExport\":\"Upgrade now to export your papers in BibTeX, CSV, and Excel.\",\"exportedSuccessfully\":\"Exported {count} papers successfully\",\"failedToExport\":\"Failed to export papers\",\"exporting\":\"Exporting...\",\"bibtex\":\"BibTeX (.bib)\",\"csv\":\"CSV (.csv)\",\"excel\":\"Excel (.xlsx)\",\"newAiSearch\":\"New: AI Search 2.0\",\"aiSearchDescription\":\"Goes deeper than regular search by scanning more papers and bringing you better, well-cited answers\",\"newChatWithPdf\":\"Chat with PDF 2.0 is here\",\"newChatWithPdfDescription\":\"Improved analysis, answers, summaries, comparisons, and follow-ups, using full document context from your PDFs.\",\"newLiteratureReview\":\"Literature Review Agent is here\",\"newLiteratureReviewDescription\":\"Run end-to-end reviews: build a protocol, shortlist papers, extract key data, and generate a structured review with citations.\",\"tryNow\":\"Try now\",\"myReferences\":\"My References\",\"sources\":\"Sources\",\"uploads\":\"Uploads\",\"cite\":\"Cite\",\"mention\":\"Mention\",\"addFile\":\"Add File\",\"addFilesToChat\":\"Add files to chat\",\"selectReferences\":\"Select References\",\"uploadFile\":\"Upload File\",\"selectOrDragAndDropFilesToAdd\":\"Select or drag and drop files to add\",\"selectOrDragAndDropFilesHereToStartTheChat\":\"Select or drag and drop files here to start the chat\",\"added\":\"Added\",\"gettingYourPapersReady\":\"Getting your papers ready...\",\"chatBeginsAfterFileProcessingCompletes\":\"Chat will be available after processing\",\"someDocumentsStillProcessing\":\"Get better answers after processing completes\",\"completed\":\"completed\",\"literatureReview\":\"Literature Review\"},\"home\":{\"meta\":{\"title\":\"Paperguide: The AI Research Assistant\",\"description\":\"Paperguide is an all-in-one AI Research Assistant to get research-backed answers, find \u0026 analyse research papers, manage references, and write documents\"},\"metaTitle\":\"Paperguide: The All-in-One AI Research Assistant\",\"metaDescription\":\"Paperguide is an All-in-One AI Research Assistant to search, chat understand research papers, streamline literature reviews, and write with ease.\",\"metaKeywords\":\"Research Manager, AI Co-writer, Chat With PDF, Chat PDF, Chat with Document\",\"heading\":\"Your All-in-One AI Research Assistant\",\"subHeading\":\"10x faster research, unlock new insights - search and understand research papers, streamline literature reviews, manage references, and write with ease—all in one integrated platform\",\"startReferenceManager\":{\"heading\":\"Reference Manager\",\"subHeading\":\"Manage, Annotate, Understand and Cite References\",\"button\":\"Start Now\"},\"faqs\":{\"heading\":\"Frequently asked questions\",\"items\":{\"faqItem1\":{\"question\":\"Who is Paperguide designed for?\",\"answer\":\"Paperguide is designed for researchers, academics, students, and professionals in any field who work with scientific literature and academic papers. It helps you find and analyze research papers, streamline literature reviews, manage references, and write papers faster—all with one AI-powered research platform.\"},\"faqItem2\":{\"question\":\"Which scientific databases do you search?\",\"answer\":\"We utilize the Semantic Scholar database, which includes over 200 million articles from various fields of science, covering sources such as PubMed, ArXiv, and many others.\"},\"faqItem3\":{\"question\":\"How can I get in touch with your team?\",\"answer\":\"You can reach us via email at hello@paperguide.ai, use our website support chat, or join our Discord community. We value your feedback and strive to respond to all inquiries as quickly as possible.\"},\"faqItem4\":{\"question\":\"Do you use full texts or just abstracts?\",\"answer\":\"For AI-powered searches, we primarily use abstracts to find relevant papers. In literature reviews, we access the full texts of available papers to provide in-depth analysis.\"},\"faqItem5\":{\"question\":\"How does Paperguide compare to traditional reference managers like Zotero or Mendeley?\",\"answer\":\"While Paperguide offers all the features of traditional reference managers, it goes beyond by integrating AI capabilities. This includes AI-powered summarization, interactive Q\u0026A with papers, and AI-assisted writing features, making it a more comprehensive tool for modern researchers.\"},\"faqItem6\":{\"question\":\"How accurate are the AI-generated summaries?\",\"answer\":\"Our AI summaries are highly accurate, trained on millions of academic papers. However, we always recommend using them as a starting point and referring to the original paper for critical information. The accuracy can vary depending on the complexity and specificity of the paper.\"},\"faqItem7\":{\"question\":\"Does Paperguide use my personal data or uploaded content to train AI models?\",\"answer\":\"No, Paperguide does not use any user data, uploaded files/content, or interactions to train AI models. Your privacy and security are our top priorities. We ensure that all data remains confidential and is not used beyond providing our services.\"},\"faqItem8\":{\"question\":\"Do you support OCR PDFs?\",\"answer\":\"Yes, we support OCR for PDFs, with a limit of 20 pages per document.\"}}},\"cta\":{\"heading\":\"Ready to Transform Your Research?\",\"subHeading\":\"Join thousands of students and researchers who are already experiencing the future of academic work.\",\"getStarted\":\"Get Started for Free\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Your All-in-One\",\"part2\":\"AI Research Assistant\"},\"subtitle\":\"Get research backed answers, find \u0026 analyze research papers, streamline literature reviews, manage references, and write documents - faster with one AI powered research platform.\",\"cta\":{\"getStarted\":\"Get Started for Free\",\"watchDemo\":\"Watch Demo\"},\"rating\":\"Rated by 1000+ Researchers and Universities\"},\"universitySection\":{\"title\":\"Academics and Professionals from Top Institutions use Paperguide for Research\"},\"features\":{\"aiSearch\":{\"title\":\"Find Papers and Get Research-backed Answers\",\"description\":\"AI-powered search that understands your queries, analyzes millions of papers, and delivers comprehensive answers with proper citations.\",\"features\":[\"Question-based search that understands your research queries beyond simple keywords\",\"Extracts data and analyzes all the relevant papers from 200 million papers database\",\"Comprehensive answers generated by analyzing the 10 most relevant papers with proper citations\"]},\"literatureReview\":{\"title\":\"Analyze Papers Faster with Accurate Data Extraction\",\"description\":\"Automatically extract and compare key data from multiple papers in a customizable format for efficient analysis and insight discovery.\",\"features\":[\"Compare multiple papers with structured summaries in an easy-to-navigate format\",\"Extract key data across hundreds of papers, including graphical and tabular information\",\"Verify findings easily with supporting quotes and original text from each source\"]},\"deepResearch\":{\"title\":\"Deep Research for Comprehensive Analysis\",\"description\":\"Go beyond basic search with AI that understands your research, finds relevant papers, and generates a complete report - transforming weeks of manual review into minutes.\",\"features\":[\"Automated paper discovery, screening, and data extraction process\",\"In-depth analysis of research trends, contradictions, and consensus in the field\",\"Generate a comprehensive report with structured sections backed by 220+ millon papers\"]},\"aiWriter\":{\"title\":\"Write Smarter with AI Backed by Your References\",\"description\":\"Generate and polish academic content using AI that leverages your references while maintaining academic integrity.\",\"features\":[\"Eliminate writer's block by generating complete drafts built on your references and scholarly database\",\"Polish your writing with simple AI commands and text humanizer for a natural academic tone\",\"Maintain academic integrity with automatic citations for all AI-generated content\"]},\"referenceManager\":{\"title\":\"Streamlined Citation and Reference Management\",\"description\":\"Effortlessly import, organize, and collaborate on references with AI-generated summaries and real-time sharing capabilities.\",\"features\":[\"Import from anywhere with support for Zotero, BibTeX, RIS, DOI, and direct URLs\",\"Get instant paper insights with AI-generated summaries of methodology and findings\",\"Collaborate in real-time with shared libraries and customizable permissions\"]}},\"additionalFeatures\":{\"title\":\"And More Reasons to Choose Paperguide\",\"features\":{\"chatWithPdf\":{\"title\":\"Chat with PDF \u0026 Papers\",\"description\":\"Ask questions directly to your papers and get instant answers without reading entire documents.\"},\"generateDocument\":{\"title\":\"Generate Full Documents\",\"description\":\"Create complete drafts with proper citations in minutes by connecting your reference knowledge to the writing process.\"},\"aiInsights\":{\"title\":\"AI Insights and Metrics\",\"description\":\"Evaluate paper quality with SJR rankings and citation metrics. Understand methodologies better with AI classification.\"},\"originalText\":{\"title\":\"Original Text for Verification\",\"description\":\"Trust but verify. See exactly where data comes from with direct access to the source text that supports each answer.\"},\"vastDatabase\":{\"title\":\"Vast Research Database\",\"description\":\"Access over 200 million papers across life sciences, academia, and other domains.\"}}},\"cta\":{\"title\":\"Speed Up Your Research with Accuracy and Ease\"}},\"startWriting\":{\"heading\":\"AI Writer\",\"subHeading\":\"Write, Improve and Cite better and faster\"}},\"referenceManager\":{\"getStartedForFree\":\"Get Started for Free\",\"meta\":{\"title\":\"Reference Manager - Free Online AI Reference Manager\",\"description\":\"Organize, annotate, cite your references and documents effortlessly with Paperguide's free online AI-powered Reference Manager\"},\"faqs\":{\"heading\":\"Frequently asked questions\",\"items\":{\"faqItem1\":{\"question\":\"Can I access my library offline?\",\"answer\":\"No. Paperguide, as of now, can only be accessed via a web browser. But in the future, we might provide an option to access without internet.\"},\"faqItem2\":{\"question\":\"How secure is my data with Paperguide?\",\"answer\":\"We take data security seriously. All your research data is encrypted and stored securely, with regular backups to ensure you never lose your valuable work.\"},\"faqItem3\":{\"question\":\"Is there a limit to how many papers I can store?\",\"answer\":\"Our free plan includes generous storage. For power users, our premium plans offer unlimited storage to accommodate even the most extensive research libraries. Please check the pricing page for more details.\"},\"faqItem4\":{\"question\":\"Can Paperguide integrate with other research tools I use?\",\"answer\":\"Yes, Paperguide is designed to integrate seamlessly with a wide range of research tools and databases, enhancing your existing workflow.\"}}},\"cta\":{\"heading\":\"Ready to Transform Your Research Experience?\",\"description\":\"Don't just manage your references—elevate your entire research journey. Join thousands of academics and researchers who are already working smarter, not harder with Paperguide.\",\"button\":\"Get Started for Free\"},\"filters\":{\"paperType\":\"Type\",\"author\":\"Author\",\"year\":\"Year\",\"hasPdf\":\"Has PDF\",\"chatWithPaper\":\"Chat with Paper\",\"chatWithPapers\":\"Chat with Papers\",\"searchByTitlePlaceholder\":\"Search by title\",\"askAiToolTip\":\"Select papers with PDF to start the chat\",\"openChat\":\"Open Chat\",\"openDetails\":\"Open Details\",\"chat\":\"Chat\",\"files\":\"Files\",\"myChats\":\"My Chats\",\"export\":{\"bib\":\"BibTeX\",\"ris\":\"RIS\"}},\"sessionExists\":{\"addPapers\":{\"heading\":\"Add Papers\",\"back\":\"Back\",\"uploadUrl\":{\"heading\":\"Upload URL or DOI\",\"description\":\"Upload papers from URL or DOI\",\"uploadUrlModal\":{\"heading\":\"Upload URL or DOI\",\"placeholder\":\"Type or Paste Upload URL or DOI\",\"button\":\"Upload\"}},\"searchPapers\":{\"heading\":\"Search Papers Online\",\"description\":\"Search papers all across the web\",\"searchPapersModal\":{\"heading\":\"Search Papers Online\",\"placeholder\":\"Enter name, question, keywords or DOI\",\"noResults\":\"No results found\"}},\"uploadFile\":{\"heading\":\"Upload File\",\"description\":\"Import PDF, DOCX\",\"uploadFileModal\":{\"heading\":\"Upload File\",\"placeholder\":{\"part1\":\"Select\",\"part2\":\"or drop file here..\"}}},\"uploadBibOrRis\":{\"heading\":\"Import BibTeX or RIS\",\"description\":\"Add BibTex or RIS files or Paste text\",\"uploadBibOrRisModal\":{\"heading\":\"Import BibTeX or RIS\",\"tabs\":{\"paste\":\"Paste\",\"pastePlaceholder\":\"Paste BibTeX or RIS\",\"upload\":\"Upload\",\"uploadPlaceholder\":{\"part1\":\"Select\",\"part2\":\"or drop file here..\"}},\"button\":\"Import\"}},\"importFromZotero\":{\"heading\":\"Import from Zotero\",\"description\":\"Migrate files from Zotero\",\"importFromZoteroModal\":{\"heading\":\"Import from Zotero\",\"description\":\"Connect your Zotero account to import your references into Paperguide.\",\"description2\":\"Select collections not exceeding 50 files each.\",\"button\":\"Connect Zotero\",\"note\":\"Note: In the next screen, click Accept Defaults to complete the setup of your Zotero account with Paperguide.\",\"zoretoConnected\":\"Zotero Connected\",\"disconnect\":\"Disconnect\",\"warningModal\":{\"heading\":\"Add References only or Skip Collections\",\"description\":\"These collections contain over 50 files each. Would you like to import only the References? Need help\",\"collectionInfo\":\"This Collection includes\",\"remainingCollections\":\"The remaining collections (less than 50 files) will be uploaded entirely.\",\"skipCollections\":\"Skip Collections\",\"importReferences\":\"Import References only\"},\"loadingMessage\":\"Fetching your Zotero folders please wait...\",\"noFoldersFound\":\"No folders found in your Zotero account\",\"importButton\":\"Import\"}}},\"tags\":{\"heading\":\"Tags\",\"createTagTooltip\":\"Create Tag\",\"tagName\":\"Tag Name\"},\"folders\":{\"moveToFolder\":\"Move to folder\",\"allPapers\":\"All Papers\",\"heading\":\"Folders\",\"sharedWithMe\":\"Shared with me\",\"noSharedFolders\":\"No Folders found\",\"folderItems\":{\"addSubFolder\":\"Add Sub Folder\",\"moveFolder\":\"Move Folder\",\"manageAccess\":\"Manage Access\",\"shareFolder\":\"Share Folder\",\"rename\":\"Rename\",\"delete\":\"Delete\"},\"createFolderModal\":{\"heading\":\"Create Folder\",\"subFolderHeading\":\"Create Sub Folder\",\"folderName\":\"Folder Name\",\"create\":\"Create\",\"cancel\":\"Cancel\"},\"moveFolderModal\":{\"heading\":\"Move Folder\"},\