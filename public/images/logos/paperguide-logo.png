e document\",\"editDocument\":\"Edit Document\",\"updateDocumentTitle\":\"Update the title of your document\",\"deleteDocument\":\"Delete Document\",\"deleteDocumentSubtitle\":\"Are you sure you want to delete this document?\",\"errorGeneratingContent\":\"Error generating content\"},\"chatWithPdf\":{\"documentDeleted\":\"Document Deleted\",\"documentDeletedSubtitle\":\"You have deleted this document. Please upload document again create new chat.\",\"hideView\":\"Hide view\",\"fileViewer\":\"File Viewer\",\"failedToRetrieveMessage\":\"Failed to retrieve message\",\"failedToLoadInitialData\":\"Failed to load initial data\",\"textIsNeededToGenerateAnswer\":\"Text is needed to generate answer!\",\"pleaseSelectChatOrFolderOrUploadNewPDF\":\"Please select chat or folder or upload new PDF\",\"holdTightWeReExtractingTextFromYourPDF\":\"Hold tight! We're extracting text from your PDF 📄🔍\",\"analyzingTheContentToFindTheKeyInformation\":\"Analyzing the content to find the key information 📘✨\",\"thanksForWaitingWeReStillProcessingToEnsureAccuracy\":\"Thanks for waiting! We're still processing to ensure accuracy 🙏⏳\",\"almostThereIPickingOutTheBestAnswersForYou\":\"Almost there! I'm picking out the best answers for you ⏳🔎\",\"yourDocumentIsBeingProcessedForChat\":\"Your document is being processed for chat. This may take up to 1-2 minutes. try your chat request again shortly.\",\"oopsYouveUsedAllYourFreeAIGenerationsToday\":\"Oops! You've used all your free AI generations today\",\"upgradeNowForUnlimitedAIGenerations\":\"Upgrade now for ⚡ Unlimited AI generations\",\"askAnythingAboutYourDocuments\":\"Ask anything about your documents\",\"ourAiWillAnalyze\":\"Our AI will help you analyze, summarize, or find specific information\",\"tryOutTheseBelowQuestions\":\"Try out these below questions:\",\"askYourQuestionHere\":\"Asks your question here... (use @ to mention a paper)\",\"clickToMentionPapers\":\"Click to mention papers\",\"takeAScreenshotOfYourQuestion\":\"Take a screenshot of your question\",\"shareChat\":\"Share chat\",\"clearChat\":\"Clear chat\",\"copiedSuccessfully\":\"Copied successfully 🎉\",\"chatClearedSuccessfully\":\"Chat cleared successfully 🎉\",\"deletedChatSuccessfully\":\"Deleted chat successfully 🎉\",\"languageChangedSuccessfully\":\"Language changed successfully 🎉\"},\"workBook\":{\"failedToGetReferenceData\":\"Failed to get reference data. Please try again.\",\"referenceAddedSuccessfully\":\"Reference added successfully 🎉\",\"selectFolderToAddToReferences\":\"Select folder to add to References\"}},\"writerDocumentTypes\":{\"researchPaper\":{\"wordCount\":\"Word count\",\"wordCountPlaceholder\":\"Enter target word count (e.g., 2000)\",\"documentTopic\":\"Research Topic/Title\",\"documentTopicPlaceholder\":\"Enter research topic or title\",\"requirements\":\"Requirements\",\"requirementsPlaceholder\":\"Enter specific requirements, sources to use, and analysis guidelines\",\"citationStyle\":\"Citation Style\"},\"literatureReview\":{\"wordCount\":\"Word count\",\"wordCountPlaceholder\":\"Enter target word count (e.g., 2000)\",\"documentTopic\":\"Literature Review Topic/Title\",\"documentTopicPlaceholder\":\"Enter literature review topic or title\",\"requirements\":\"Requirements\",\"requirementsPlaceholder\":\"Enter specific requirements, sources to use, and synthesis guidelines\",\"reviewType\":\"Type of Review\",\"reviewTypeOptions\":{\"systematic\":\"Systematic\",\"narrative\":\"Narrative\",\"metaAnalysis\":\"Meta-analysis\"},\"citationStyle\":\"Citation Style\"},\"caseStudy\":{\"wordCount\":\"Word count\",\"wordCountPlaceholder\":\"Enter target word count (e.g., 2000)\",\"documentTopic\":\"Case Study Topic/Title\",\"documentTopicPlaceholder\":\"Enter case study topic or title\",\"requirements\":\"Requirements\",\"requirementsPlaceholder\":\"Enter specific requirements, sources to use, and analysis guidelines\",\"citationStyle\":\"Citation Style\"},\"essay\":{\"wordCount\":\"Word count\",\"wordCountPlaceholder\":\"Enter target word count (e.g., 2000)\",\"documentTopic\":\"Essay Topic/Title\",\"documentTopicPlaceholder\":\"Enter essay topic or title\",\"requirements\":\"Requirements\",\"requirementsPlaceholder\":\"Enter specific requirements, sources to use, and analysis guidelines\",\"essayType\":\"Type of Essay\",\"essayTypeOptions\":{\"argumentative\":\"Argumentative\",\"narrative\":\"Narrative\",\"descriptive\":\"Descriptive\",\"expository\":\"Expository\"},\"citationStyle\":\"Citation Style\"},\"article\":{\"wordCount\":\"Word count\",\"wordCountPlaceholder\":\"Enter target word count (e.g., 2000)\",\"documentTopic\":\"Article Topic/Title\",\"documentTopicPlaceholder\":\"Enter article topic or title\",\"requirements\":\"Requirements\",\"requirementsPlaceholder\":\"Enter specific requirements, sources to use, and analysis guidelines\",\"citationStyle\":\"Citation Style\"}},\"deepSearch\":{\"meta\":{\"title\":\"Automate Systematic Reviews with Deep Research AI\",\"description\":\"Paperguide’s Deep Research AI searches, screens, analyzes, and writes rapid systematic review reports, automating your entire evidence-synthesis workflow with a single click.\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Fully Automate Systematic Reviews with\",\"part2\":\"AI Deep Research Reports\"},\"subtitle\":\"Automate your research - from literature discovery to research reports. Powered by AI and semantic search, it finds, analyzes, and synthesizes hundreds of papers with a single click.\"},\"whatIsDeepResearch\":{\"heading\":\"What is Deep Research?\",\"description\":\"Deep Research by Paperguide automatically conducts comprehensive literature reviews from your research question. It searches millions of papers, extracts data, analyzes findings, and delivers fully cited reports, transforming weeks of manual research into hours of automated synthesis.\",\"features\":[{\"name\":\"Research Planning\",\"description\":\"Interprets your question to create a structured research plan with defined parameters.\"},{\"name\":\"Semantic Search\",\"description\":\"Autonomously semantic searches millions of papers to find relevant, and up-to-date information.\"},{\"name\":\"Evaluating and Screening\",\"description\":\"Rigorously evaluates and screens papers, prioritizing relevance, quality and credibility.\"},{\"name\":\"Extracting and Analyzing\",\"description\":\"Extracts data, resolves contradictions and synthesizes findings into coherent narratives.\"},{\"name\":\"Research Reporting\",\"description\":\"Delivers fully-cited research reports that transform findings into actionable insights.\"}]},\"features\":{\"heading\":\"Features\",\"feature1\":{\"heading\":\"Intelligent Research Synthesis \",\"description\":\"AI goes beyond simple summarization by brainstorming across extracted literature to generate novel insights, identify research gaps, and create comprehensive analytical reports.\",\"features\":[\"Synthesizes complex information into clear, actionable findings\",\"Highlights unexplored areas and potential for further study\",\"Produces detailed, multi-layered research reports automatically\"]},\"feature2\":{\"heading\":\"Semantic Understanding \u0026 Search\",\"description\":\"Deep Research truly understands your research question—not just keywords. It explores related topics and generates similar queries to ensure complete coverage of your research area.\",\"features\":[\"Understands research intent through semantic analysis\",\"Creates similar and nuanced questions to cover broader intent\",\"Avoids missing relevant research by going beyond keyword search\"]},\"feature3\":{\"heading\":\"Verified \u0026 Transparent Citations\",\"description\":\"Every insight, claim, and finding comes with full citations and verifiable sources. No assumptions or unsupported statements—ensuring research credibility and academic integrity.\",\"features\":[\"Provides clear source attribution for every claim\",\"Guarantees traceability back to original academic papers\",\"Maintains rigorous standards of academic integrity\"]},\"feature4\":{\"heading\":\"Multi-Criteria Source Evaluation\",\"description\":\"Evaluates sources deeply, using tailored screening criteria beyond just topic relevance to guarantee quality and applicability for your research.\",\"features\":[\"Builds custom evaluation fields based on your specific needs\",\"Screens papers against multiple relevance and quality metrics\",\"Filters out irrelevant or low-quality sources effectively\"]}},\"additionalFeatures\":{\"title\":\"And More Reasons to Choose Deep Research\",\"endToEndTraceability\":{\"heading\":\"End-to-End Traceability\",\"description\":\"Deep Research provides a complete traceability trail, from research question to final report. This ensures that every claim and finding is backed by the original academic papers.\"},\"dataVisualizations\":{\"heading\":\"Data Visualizations\",\"description\":\"Transforms extracted statistics and trends into ready-to-use tables, charts, and graphs, making data interpretation effortless.\"},\"complexAnalysis\":{\"heading\":\"Complex Analysis\",\"description\":\"Breaks down complex subjects into connected sub-topics, helping you navigate interdisciplinary questions effectively.\"},\"researchGapDetection\":{\"heading\":\"Research Gap Detection\",\"description\":\"Pinpoints unanswered questions and under-researched areas, creating roadmaps for novel investigations and funding.\"},\"collaborativeResearch\":{\"heading\":\"Collaborative Research\",\"description\":\"Share reports with teammates and collaborate. Easily reuse content in your own articles with citations intact.\"}},\"academicDisciplines\":{\"heading\":\"Deep Research Across Academic Disciplines\",\"features\":[{\"name\":\"Literature Reviews\",\"description\":\"Generate comprehensive literature reviews for academic papers and grant proposals in minutes, not weeks\"},{\"name\":\"Market Research\",\"description\":\"Analyze industry trends and competitive landscapes through academic and professional publications\"},{\"name\":\"Medical Research\",\"description\":\"Conduct systematic reviews of clinical studies and treatment efficacies with precise data extraction\"},{\"name\":\"Policy Research\",\"description\":\"Synthesize evidence from multiple studies to inform policy decisions with comprehensive analysis\"},{\"name\":\"Competitive Intelligence\",\"description\":\"Track research developments, identify emerging trends, and stay ahead of competition\"},{\"name\":\"Systematic Reviews\",\"description\":\"Automate rigorous systematic reviews with standardized search and data extraction from hundreds of studies\"}]},\"integrateWorkflow\":{\"heading\":\"Integrate With Your Workflow\",\"description\":\"Paperguide's AI Deep Research connects seamlessly with our complete research ecosystem:\",\"features\":[{\"name\":\"AI Search\",\"description\":\"Refine and expand your research with targeted searches\"},{\"name\":\"Literature Review\",\"description\":\"Incorporate insights from your literature reviews into your writing\"},{\"name\":\"AI Writer\",\"description\":\"Use a generated reports as foundation for your manuscripts\"}]},\"faqs\":{\"heading\":\"Frequently Asked Questions\",\"items\":{\"faqItem1\":{\"question\":\"How long does a Deep Research report take?\",\"answer\":\"Reports are typically generated in just 10-15 minutes. You'll receive an email notification once your report is ready, and you can access all your reports anytime in your history.\"},\"faqItem2\":{\"question\":\"Can I reuse the generated reports?\",\"answer\":\"Yes, you can copy, download, and reuse your reports directly in Paperguide's AI Writer or export them to other writing tools. All citations are preserved, making it seamless to incorporate findings into your work.\"},\"faqItem3\":{\"question\":\"How accurate is the data extraction?\",\"answer\":\"We use only reputable scholarly databases to ensure quality. Our AI has been specifically trained on academic content and continuously improved to maintain high accuracy in data extraction and analysis.\"},\"faqItem4\":{\"question\":\"Is Deep Research suitable for all research fields?\",\"answer\":\"Yes, Deep Research works across all academic disciplines, from life sciences to humanities, engineering to social sciences.\"},\"faqItem5\":{\"question\":\"What types of sources does Deep Research analyze?\",\"answer\":\"Deep Research analyzes peer-reviewed journals, conference papers, preprints, and other academic sources from our 200+ million paper database.\"}}}}},\"solutions\":{\"solution1\":{\"meta\":{\"title\":\"Academic Research \u0026 Literature Review\",\"description\":\"Accelerate your research process with AI-powered literature analysis and comprehensive review writing capabilities. From exploring research topics to writing detailed literature reviews, we streamline your academic workflow.\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Academic Research \u0026 Literature Review\",\"part2\":\"AI Deep Research Reports\"},\"subtitle\":\"Accelerate your research process with AI-powered literature analysis and comprehensive review writing capabilities. From exploring research topics to writing detailed literature reviews, we streamline your academic workflow.\"},\"problemsWeRemove\":{\"heading\":\"Problems We Solve\",\"description\":\"Deep Research by Paperguide automatically conducts comprehensive literature reviews from your research question. It searches millions of papers, extracts data, analyzes findings, and delivers fully cited reports, transforming weeks of manual research into hours of automated synthesis.\",\"features\":[{\"title\":\"Literature Reviews Take Months\",\"description\":\"Reading and analyzing hundreds of papers across databases takes 2-4 months of manual work.\"},{\"title\":\"Hard to Identify Key Research\",\"description\":\"Manually extracting concepts, gaps, and frameworks from studies is time-intensive and error-prone.\"},{\"title\":\"Missing Important Studies\",\"description\":\"Manual searches miss relevant research from adjacent fields that could provide crucial insights.\"},{\"title\":\"Difficult to Compare Research Methods\",\"description\":\"Understanding how researchers approached similar questions requires extensive methodology analysis across multiple papers.\"},{\"title\":\"Writing Literature Reviews is Overwhelming\",\"description\":\"Organizing findings from hundreds of papers into coherent arguments while citing properly is demanding.\"}]},\"whatYouDo\":{\"heading\":\"How Paperguide Works\",\"features\":[{\"title\":\"Explore Your Research Topic\",\"description\":\"Ask broad questions about your research area to understand the current state of knowledge, key theories, and major research directions.\",\"description2\":\"Example: What are the main theoretical frameworks used in social media addiction research?\"},{\"title\":\"Identify Research Themes and Gaps\",\"description\":\"Use Deep Research to generate comprehensive reports that analyze research trends, identify key themes, and highlight areas where more research is needed.\"},{\"title\":\"Compare Research Approaches\",\"description\":\"Use Literature Review to extract and compare methodologies, theoretical frameworks, and findings from multiple studies in organized tables.\"},{\"title\":\"Understand Complex Studies\",\"description\":\"Chat with specific papers to clarify theoretical concepts, understand research designs, or get explanations of statistical analyses relevant to your field.\"},{\"title\":\"Write Specific Review Sections\",\"description\":\"Use AI Writer to generate thematic literature review sections, theoretical background chapters, and methodology discussions with automatic citations.\"},{\"title\":\"Organize Your Research\",\"description\":\"Use Reference Manager to organize all your sources with AI-generated summaries of key contributions, methodologies, and findings from each paper.\"}]},\"socialProof\":{\"heading\":\"Social Proof\",\"features\":[{\"title\":\"PhD Student, Psychology Department\",\"description\":\"Paperguide transformed my dissertation literature review. What normally takes 4-6 months of reading and organizing papers was completed in 3 weeks, and I discovered research connections I wouldn't have found manually.\"},{\"title\":\"Dr. Emily Carter, Assistant Professor\",\"description\":\"For my NIH grant application, Paperguide helped me analyze 300+ studies across multiple disciplines. The literature review section was comprehensive and identified key research gaps that strengthened my proposal.\"},{\"title\":\"Master's Student, Environmental Science\",\"description\":\"Paperguide helped me understand the complex landscape of climate change adaptation research. The AI analysis revealed theoretical frameworks and methodological approaches I used throughout my thesis.\"}]},\"whoIsThisFor\":{\"heading\":\"Who Is This For?\",\"description\":\"Paperguide's AI Deep Research is designed for students, researchers, and professionals in academia, business, and industry who need to conduct comprehensive literature reviews and synthesize research findings quickly and efficiently.\",\"features\":[{\"title\":\"Graduate Students \u0026 PhD Researchers\",\"description\":\"conducting literature reviews for dissertations and theses\"},{\"title\":\"Academic Researchers\",\"description\":\"exploring new research areas and writing comprehensive literature analyses\"},{\"title\":\"Undergraduate Students\",\"description\":\"writing literature review sections for capstone projects and research papers\"},{\"title\":\"Faculty Members\",\"description\":\"researching grant applications and exploring interdisciplinary connections\"},{\"title\":\"Research Assistants\",\"description\":\"supporting principal investigators with literature analysis and background research\"},{\"title\":\"Postdoctoral Researchers\",\"description\":\"investigating new research directions and writing review articles\"}]},\"productFeatures\":{\"heading\":\"Product Features\",\"features\":[{\"title\":\"Deep Research AI\",\"description\":\"Get comprehensive reports analyzing your topic from multiple angles with research trends and gaps.\"},{\"title\":\"AI Search\",\"description\":\"Ask specific research questions and get immediate answers with citations to explore concepts.\"},{\"title\":\"Literature Review\",\"description\":\"Compare frameworks, methodologies, and findings across studies with consistent data extraction tables.\"},{\"title\":\"AI Writer with Citations\",\"description\":\"Generate complete literature review drafts or sections with automatic references and citations.\"},{\"title\":\"Chat with Papers\",\"description\":\"Ask questions directly to papers to understand theories, methodologies, or research connections.\"},{\"title\":\"AI Reference Manager\",\"description\":\"Organize literature with AI summaries highlighting each paper's contribution, methodology, and findings.\"}]},\"faqs\":{\"heading\":\"Frequently Asked Questions\",\"items\":{\"faqItem1\":{\"question\":\"Can I use AI-generated literature reviews directly in my work?\",\"answer\":\"AI-generated content provides excellent starting points with proper citations, but all literature reviews should be reviewed, customized, and validated by researchers before submission to ensure academic rigor.\"},\"faqItem2\":{\"question\":\"Does Paperguide work across all academic disciplines?\",\"answer\":\"Yes, Paperguide covers humanities, social sciences, natural sciences, engineering, medicine, and interdisciplinary fields with relevant terminology and theoretical understanding.\"},\"faqItem3\":{\"question\":\"How does it help identify research gaps?\",\"answer\":\"Paperguide analyzes patterns across multiple studies to highlight areas where research is limited, conflicting, or absent, helping you identify opportunities for original contributions.\"},\"faqItem4\":{\"question\":\"Can I collaborate with my advisor or research team?\",\"answer\":\"You can share research reports and reference libraries with advisors and team members, enabling collaborative literature analysis with shared access to findings and citations.\"},\"faqItem5\":{\"question\":\"Does it help with literature reviews for grant writing?\",\"answer\":\"Yes, Paperguide can research background information and generate literature review sections for grant applications. All content should be customized for specific funding agency requirements.\"},\"faqItem6\":{\"question\":\"How does it handle interdisciplinary research?\",\"answer\":\"Paperguide excels at finding connections across disciplines by analyzing papers from multiple fields, helping you understand how your research fits into broader academic conversations.\"}}}}},\"solution2\":{\"meta\":{\"title\":\"Drug Discovery \u0026 Pre-clinical Research\",\"description\":\"Accelerate drug discovery with comprehensive literature analysis on targets, mechanisms, and compounds. Research faster, understand complex pathways, and identify opportunities with AI-powered scientific intelligence.\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Drug Discovery \u0026 Pre-Clinical Research\",\"part2\":\"Accelerate drug discovery with comprehensive literature analysis on targets, mechanisms, and compounds. Research faster, understand complex pathways, and identify opportunities with AI-powered scientific intelligence.\"},\"subtitle\":\"Accelerate your research process with AI-powered literature analysis and comprehensive review writing capabilities. From exploring research topics to writing detailed literature reviews, we streamline your academic workflow.\"},\"problemsWeRemove\":{\"heading\":\"Problems We Solve\",\"description\":\"Deep Research by Paperguide automatically conducts comprehensive literature reviews from your research question. It searches millions of papers, extracts data, analyzes findings, and delivers fully cited reports, transforming weeks of manual research into hours of automated synthesis.\",\"features\":[{\"title\":\"Target Research Takes Months\",\"description\":\"Researching drug targets, disease mechanisms, and therapeutic pathways takes 2-4 months of comprehensive literature analysis.\"},{\"title\":\"Hard to Track Competitive Intelligence\",\"description\":\"Monitoring competitor pipelines, patent landscapes, and published research on similar targets requires constant surveillance.\"},{\"title\":\"Difficult to Understand Complex Mechanisms\",\"description\":\"Analyzing biological pathways, drug-target interactions, and mechanism studies from hundreds of papers is demanding.\"},{\"title\":\"Writing Research Documents is Slow\",\"description\":\"Creating target profiles, investigational brochures, and pre-clinical reports requires extensive literature research and citations.\"},{\"title\":\"Missing Critical Safety Information\",\"description\":\"Manual searches often miss important toxicity studies, drug interactions, or safety signals that impact development decisions.\"}]},\"whatYouDo\":{\"heading\":\"How Paperguide Works\",\"features\":[{\"title\":\"Research Drug Targets\",\"description\":\"Ask questions about specific targets, their biology, and therapeutic potential. Get comprehensive answers with citations from relevant molecular and cellular studies.\",\"description2\":\"Example: What is known about KRASG12C as a therapeutic target in non-small cell lung cancer?\"},{\"title\":\"Analyze Competitive Landscape\",\"description\":\"Use Literature Review to extract and compare drug development approaches, clinical results, and competitive positioning from published studies and trial data.\"},{\"title\":\"Understand Mechanisms of Action\",\"description\":\"Chat with specific papers to clarify complex biological pathways, drug-target interactions, and pharmacological mechanisms relevant to your research.\"},{\"title\":\"Research Safety and Toxicology\",\"description\":\"Search for information about toxicity profiles, adverse effects, or safety considerations for drug classes or specific compounds. Get summaries with citations.\"},{\"title\":\"Write Research Documents\",\"description\":\"Use AI Writer to generate target product profiles, literature review sections, and pre-clinical research reports with automatic citations.\"},{\"title\":\"Generate Target Intelligence Reports\",\"description\":\"Use Deep Research to get comprehensive reports on drug targets, therapeutic areas, or competitive landscapes for strategic planning.\"}]},\"whoIsThisFor\":{\"heading\":\"Who Is This For?\",\"description\":\"Paperguide's AI Deep Research is designed for students, researchers, and professionals in academia, business, and industry who need to conduct comprehensive literature reviews and synthesize research findings quickly and efficiently.\",\"features\":[{\"title\":\"Drug Discovery Scientists\",\"description\":\"researching novel targets and therapeutic mechanisms\"},{\"title\":\"Medicinal Chemists\",\"description\":\"analyzing structure-activity relationships and compound optimization\"},{\"title\":\"Pharmacologists\",\"description\":\"studying drug mechanisms, pharmacokinetics, and safety profiles\"},{\"title\":\"Biotech Research Teams\",\"description\":\"developing new therapeutic approaches and drug candidates\"},{\"title\":\"Target Biology Researchers\",\"description\":\"investigating disease mechanisms and drug targets\"},{\"title\":\"Pre-clinical Development Teams\",\"description\":\"preparing IND applications and safety studies\"}]},\"productFeatures\":{\"heading\":\"Product Features\",\"features\":[{\"title\":\"Deep Research AI\",\"description\":\"Generate comprehensive reports on drug targets, therapeutic mechanisms, or competitive landscapes with development opportunities.\"},{\"title\":\"Literature Review\",\"description\":\"Extract and compare target data, compound properties, efficacy results, and safety profiles with structured analysis.\"},{\"title\":\"AI Search\",\"description\":\"Ask specific drug discovery questions and get immediate answers with citations about target biology.\"},{\"title\":\"Chat with Papers\",\"description\":\"Ask questions directly to molecular biology papers about mechanisms, results, or experimental approaches.\"},{\"title\":\"AI Writer with Citations\",\"description\":\"Generate target product profiles, investigational brochures, and pre-clinical sections with automatic references.\"},{\"title\":\"AI Reference Manager\",\"description\":\"Organize drug discovery literature with AI summaries of target biology, mechanisms, and therapeutic potential.\"}]},\"faqs\":{\"heading\":\"Frequently Asked Questions\",\"items\":{\"faqItem1\":{\"question\":\"Does Paperguide work across different therapeutic areas?\",\"answer\":\"Yes, Paperguide covers oncology, neuroscience, immunology, cardiovascular, metabolic diseases, and other therapeutic areas with relevant drug discovery terminology and context.\"},\"faqItem2\":{\"question\":\"Can it help with patent landscape analysis?\",\"answer\":\"Paperguide can analyze published patent literature and research publications. Formal patent analysis should be conducted with patent professionals and specialized databases.\"},\"faqItem3\":{\"question\":\"How current is the drug discovery data?\",\"answer\":\"Paperguide accesses over 200 million papers including recent drug discovery publications, pre-clinical studies, and medicinal chemistry research. Always verify with current literature and databases.\"},\"faqItem4\":{\"question\":\"Can I research specific drug mechanisms?\",\"answer\":\"Yes, you can extract detailed information about drug mechanisms, target interactions, pharmacokinetics, and pharmacodynamics from published studies and reviews.\"},\"faqItem5\":{\"question\":\"Does it help with IND preparation?\",\"answer\":\"Paperguide can research background literature and generate sections for investigational brochures. All regulatory documents should be reviewed by qualified drug development professionals.\"},\"faqItem6\":{\"question\":\"Can drug discovery teams collaborate?\",\"answer\":\"You can share research reports and reference libraries with team members, enabling collaborative drug discovery research with shared access to target intelligence and literature analysis.\"}}}}},\"solution3\":{\"meta\":{\"title\":\"Clinical Trial Design \u0026 Protocol Writing\",\"description\":\"Use AI to research existing trials, analyze study designs, and write clinical protocol sections with proper citations. Build stronger trial protocols more efficiently with comprehensive literature support.\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Research-Backed Clinical Trial Design \u0026 Protocol Writing\",\"part2\":\"Design clinical trials with AI-powered evidence synthesis and protocol writing. Get research-backed trial designs, protocols, and regulatory submissions with AI-generated content.\"},\"subtitle\":\"Use AI to research existing trials, analyze study designs, and write protocol sections with proper citations. Build stronger trial protocols more efficiently with comprehensive literature support.\"},\"problemsWeRemove\":{\"heading\":\"Problems We Solve\",\"description\":\"Deep Research by Paperguide automatically conducts comprehensive literature reviews from your research question. It searches millions of papers, extracts data, analyzes findings, and delivers fully cited reports, transforming weeks of manual research into hours of automated synthesis.\",\"features\":[{\"title\":\"Literature Research Takes Months\",\"description\":\"Finding and reviewing relevant trials to support protocol design takes 2-3 months of searching.\"},{\"title\":\"Hard to Compare Similar Trials\",\"description\":\"Manually extracting study designs, endpoints, and methods from dozens of trials is time-consuming.\"},{\"title\":\"Writing Protocol Sections is Slow\",\"description\":\"Creating background sections, study rationale, and methodology descriptions requires extensive literature review and citations.\"},{\"title\":\"Missing Important Studies\",\"description\":\"Manual searches miss relevant trials that could inform better design decisions or safety considerations.\"},{\"title\":\"Inconsistent Design Choices\",\"description\":\"Without comprehensive evidence review, justifying design decisions like endpoints or criteria is difficult.\"}]},\"whatYouDo\":{\"heading\":\"How Paperguide Works\",\"features\":[{\"title\":\"Research Regulatory Guidance\",\"description\":\"Ask questions about FDA, EMA, or other regulatory requirements for your therapeutic area. Get comprehensive answers with citations from official guidance documents.\",\"description2\":\"Example: What are the FDA requirements for cardiovascular safety studies in diabetes drug development?\"},{\"title\":\"Compare Similar Trial Designs\",\"description\":\"Use Literature Review to extract and compare study designs from multiple trials. See how other studies chose endpoints, inclusion criteria, and statistical methods.\"},{\"title\":\"Find Research Gaps\",\"description\":\"Use AI Search to explore current research in your area and see what has been studied. Review the existing evidence to identify gaps and opportunities for your new trial, or use Deep Research to get comprehensive reports that highlight understudied areas.\"},{\"title\":\"Write Protocol Sections\",\"description\":\"Use AI Writer to generate background, rationale, and methodology sections with automatic citations. Get draft content that references relevant studies.\"},{\"title\":\"Verify Design Decisions\",\"description\":\"Chat with specific papers to understand why other trials made certain design choices. Get detailed explanations from published protocols.\"},{\"title\":\"Check Study Quality\",\"description\":\"Use SJR rankings to evaluate the quality of trials informing your design. Focus on high-impact studies for key design decisions.\"}]},\"whoIsThisFor\":{\"heading\":\"Who Is This For?\",\"description\":\"Paperguide's AI Deep Research is designed for students, researchers, and professionals in academia, business, and industry who need to conduct comprehensive literature reviews and synthesize research findings quickly and efficiently.\",\"features\":[{\"title\":\"Clinical Investigators\",\"description\":\"designing new trials and writing study protocols\"},{\"title\":\"Protocol Writers\",\"description\":\"creating trial documents for regulatory approval\"},{\"title\":\"Regulatory Affairs Specialists\",\"description\":\"preparing drug applications and supporting documentation\"},{\"title\":\"CRO Teams\",\"description\":\"developing protocols for pharmaceutical clients\"},{\"title\":\"Medical Writers\",\"description\":\"creating regulatory documents and clinical study reports\"},{\"title\":\"Biostatisticians\",\"description\":\"selecting study designs and statistical methods\"}]},\"productFeatures\":{\"heading\":\"Product Features\",\"features\":[{\"title\":\"Deep Research AI\",\"description\":\"Get comprehensive reports on therapeutic areas with detailed analysis of existing trials and gaps.\"},{\"title\":\"Literature Review\",\"description\":\"Compare trial designs across studies in organized tables with endpoint and safety data.\"},{\"title\":\"AI Search\",\"description\":\"Ask specific trial design questions and get immediate answers with citations about optimal approaches.\"},{\"title\":\"AI Writer with Citations\",\"description\":\"Generate protocol sections like background and methodology with automatic references to relevant studies.\"},{\"title\":\"Chat with Papers\",\"description\":\"Ask questions directly to published trial protocols to understand specific design and methodology choices.\"},{\"title\":\"Custom Data Extraction\",\"description\":\"Create extraction forms for protocol elements like endpoints, populations, or methods for consistent comparison.\"}]},\"faqs\":{\"heading\":\"Frequently Asked Questions\",\"items\":{\"faqItem1\":{\"question\":\"Can Paperguide help with regulatory requirements?\",\"answer\":\"Paperguide can research published guidance documents and analyze how recent trials addressed regulatory requirements. Always verify current requirements with regulatory specialists.\"},\"faqItem2\":{\"question\":\"Does it work with different regulatory agencies?\",\"answer\":\"Yes, Paperguide analyzes guidance documents from FDA, EMA, Health Canada, PMDA, and other regulatory agencies worldwide. Always confirm current requirements with official agency sources.\"},\"faqItem3\":{\"question\":\"How current is the trial data?\",\"answer\":\"Paperguide accesses over 200 million papers including recent trial publications. For the most recent results, check current trial registries and databases.\"},\"faqItem4\":{\"question\":\"Can I use generated content directly in my protocol?\",\"answer\":\"AI-generated content provides a strong starting point with citations, but all protocol sections should be reviewed and customized by qualified professionals.\"},\"faqItem5\":{\"question\":\"Does it work for all therapeutic areas?\",\"answer\":\"Yes, Paperguide works across oncology, cardiology, neurology, immunology, rare diseases, and other therapeutic areas with relevant terminology and context.\"},\"faqItem6\":{\"question\":\"Can my team collaborate on protocol development?\",\"answer\":\"You can share research reports and reference libraries with team members for collaborative protocol development using the same evidence base.\"},\"faqItem7\":{\"question\":\"What about analyzing competitor trials?\",\"answer\":\"Paperguide analyzes published trials and public information. It cannot access confidential competitive data, so ensure compliance with your organization's policies.\"}}}}},\"solution4\":{\"meta\":{\"title\":\"Automate Systematic Reviews with Deep Research AI\",\"description\":\"Paperguide’s Deep Research AI searches, screens, analyzes, and writes rapid systematic review reports, automating your entire evidence-synthesis workflow with a single click.\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Evidence-Based Health Economics \u0026 Outcomes Research\",\"part2\":\"Design clinical trials with AI-powered evidence synthesis and protocol writing. Get research-backed trial designs, protocols, and regulatory submissions with AI-generated content.\"},\"subtitle\":\"Research cost-effectiveness data, analyze real-world evidence, and write HEOR reports with comprehensive literature support. Build stronger economic evaluations faster with AI-powered research.\"},\"problemsWeRemove\":{\"heading\":\"Problems We Solve\",\"description\":\"Deep Research by Paperguide automatically conducts comprehensive literature reviews from your research question. It searches millions of papers, extracts data, analyzes findings, and delivers fully cited reports, transforming weeks of manual research into hours of automated synthesis.\",\"features\":[{\"title\":\"Literature Reviews Take Months\",\"description\":\"Finding and reviewing economic studies, cost data, and outcomes research typically takes 2-4 months.\"},{\"title\":\"Hard to Extract Economic Data\",\"description\":\"Manually collecting cost estimates, utility values, and resource use data from studies is inconsistent.\"},{\"title\":\"Difficult to Compare Study Methods\",\"description\":\"Extracting and comparing economic modeling approaches and outcome measures requires extensive analysis.\"},{\"title\":\"Writing Reports is Slow\",\"description\":\"Creating systematic reviews, health technology assessments, and economic reports requires extensive research and citations.\"},{\"title\":\"Missing Key Studies\",\"description\":\"Manual searches miss relevant economic studies or evidence that could strengthen analysis.\"}]},\"whatYouDo\":{\"heading\":\"How Paperguide Works\",\"features\":[{\"title\":\"Research Economic Evidence\",\"description\":\"Ask questions about cost-effectiveness, budget impact, or outcomes data for specific treatments. Get comprehensive answers with citations from relevant HEOR studies.\",\"description2\":\"Example: What are the cost-effectiveness ratios for biologic treatments in rheumatoid arthritis?\"},{\"title\":\"Analyze Health Policy Impact\",\"description\":\"Use Deep Research to generate comprehensive reports on health policy topics, treatment guidelines, or reimbursement decisions across different healthcare systems.\"},{\"title\":\"Extract Cost and Outcome Data\",\"description\":\"Use Literature Review to extract and compare cost estimates, utility values, clinical outcomes, and resource use data from multiple economic studies in organized tables.\"},{\"title\":\"Compare HEOR Methodologies\",\"description\":\"Analyze how different studies approached economic modeling, outcome measurement, or statistical analysis. See how methodological approaches vary across similar evaluations.\"},{\"title\":\"Write HEOR Sections\",\"description\":\"Use AI Writer to generate systematic literature review sections, background chapters, and methodology descriptions with automatic citations for your reports.\"},{\"title\":\"Understand Complex Economic Models\",\"description\":\"Chat with specific HEOR papers to clarify modeling assumptions, understand cost calculations, or get explanations of economic evaluation methods.\"}]},\"whoIsThisFor\":{\"heading\":\"Who Is This For?\",\"description\":\"Paperguide's AI Deep Research is designed for students, researchers, and professionals in academia, business, and industry who need to conduct comprehensive literature reviews and synthesize research findings quickly and efficiently.\",\"features\":[{\"title\":\"Health Economists\",\"description\":\"conducting cost-effectiveness and budget impact analyses\"},{\"title\":\"Outcomes Researchers\",\"description\":\"analyzing real-world evidence and patient-reported outcomes\"},{\"title\":\"Market Access Teams\",\"description\":\"developing value propositions and reimbursement strategies\"},{\"title\":\"HEOR Consultants\",\"description\":\"creating health technology assessments for clients\"},{\"title\":\"Pharmaceutical HEOR Teams\",\"description\":\"supporting regulatory and payer submissions\"},{\"title\":\"Health Policy Researchers\",\"description\":\"analyzing healthcare interventions and policy impacts\"}]},\"productFeatures\":{\"heading\":\"Product Features\",\"features\":[{\"title\":\"Deep Research AI\",\"description\":\"Get comprehensive reports on health economics topics with detailed analysis of economic evidence.\"},{\"title\":\"Literature Review\",\"description\":\"Extract and compare cost data, utility values, and outcomes across studies with structured tables.\"},{\"title\":\"AI Search\",\"description\":\"Ask specific HEOR questions and get immediate answers with citations about cost-effectiveness data.\"},{\"title\":\"AI Writer with Citations\",\"description\":\"Generate systematic reviews, health technology assessments, and economic reports with automatic references.\"},{\"title\":\"Chat with Papers\",\"description\":\"Ask questions directly to HEOR papers about modeling assumptions, calculations, or methodology choices.\"},{\"title\":\"Custom Data Extraction\",\"description\":\"Create extraction forms for HEOR elements like cost categories, outcomes, or time horizons.\"}]},\"faqs\":{\"heading\":\"Frequently Asked Questions\",\"items\":{\"faqItem1\":{\"question\":\"Does Paperguide work for different healthcare systems?\",\"answer\":\"Yes, Paperguide analyzes HEOR studies from various healthcare systems including US, UK, Canada, Australia, and European countries with relevant cost and policy context.\"},\"faqItem2\":{\"question\":\"Can it help with HTA submissions?\",\"answer\":\"Paperguide helps research background evidence and generate literature review sections with citations. All HTA submissions should be reviewed by HEOR professionals familiar with specific agency requirements.\"},\"faqItem3\":{\"question\":\"How current is the economic data?\",\"answer\":\"Paperguide accesses over 200 million papers including recent HEOR publications and health policy documents. Always verify current cost data and policy guidelines with official sources.\"},\"faqItem4\":{\"question\":\"Can I extract specific cost categories?\",\"answer\":\"Yes, you can create custom extraction columns for direct costs, indirect costs, utility values, resource utilization, or any other economic parameters from multiple studies.\"},\"faqItem5\":{\"question\":\"Does it help with budget impact models?\",\"answer\":\"Paperguide can research epidemiological data, treatment patterns, and cost inputs that inform budget impact models. Model development should be conducted by qualified health economists.\"},\"faqItem6\":{\"question\":\"Can my HEOR team collaborate?\",\"answer\":\"You can share research reports and reference libraries with team members, enabling collaborative HEOR research with shared access to economic evidence and literature analysis.\"}}}}},\"solution5\":{\"meta\":{\"title\":\"Meta-Analyses \u0026 Systematic Reviews\",\"description\":\"Automate systematic review workflows from the search to analysis. Generate comprehensive reviews and meta-analyses with transparent methodology, data extraction, and statistical synthesis.\"},\"pageContent\":{\"hero\":{\"title\":{\"part1\":\"Meta-Analyses \u0026 Systematic Reviews\",\"part2\":\"Design clinical trials with AI-powered evidence synthesis and protocol writing. Get research-backed trial designs, protocols, and regulatory submissions with AI-generated content.\"},\"subtitle\":\"Automate systematic review workflows from the search to analysis. Generate comprehensive reviews and meta-analyses with transparent methodology, data extraction, and statistical synthesis.\"},\"problemsWeRemove\":{\"heading\":\"Problems We Solve\",\"description\":\"Deep Research by Paperguide automatically conducts comprehensive literature reviews from your research question. It searches millions of papers, extracts data, analyzes findings, and delivers fully cited reports, transforming weeks of manual research into hours of automated synthesis.\",\"features\":[{\"title\":\"Systematic Search Takes Months\",\"description\":\"Traditional systematic reviews require searching multiple databases manually, taking 2-4 months for search phase.\"},{\"title\":\"Screening Hundreds of Papers\",\"description\":\"Reviewing titles, abstracts, and full texts of 500-2000+ papers leads to inconsistent screening.\"},{\"title\":\"Data Extraction is Error-Prone and Time-Intensive\",\"description\":\"Manually extracting effect sizes, confidence intervals, and methodology details is tedious and error-prone.\"},{\"title\":\"Statistical Synthesis is Complex\",\"description\":\"Calculating pooled effect sizes, assessing heterogeneity, and conducting subgroup analyses requires extensive expertise.\"},{\"title\":\"Quality Assessment is Inconsistent\",\"description\":\"Evaluating study quality using Cochrane Risk of Bias tools manually leads to inconsistent assessments.\"}]},\"whatYouDo\":{\"heading\":\"How Paperguide Works\",\"features\":[{\"title\":\"Define Your Review Question (2 minutes)\",\"description\":\"Input your PICO question or systematic review objective. Paperguide's AI interprets your question and creates a structured search strategy with defined inclusion/exclusion criteria.\",\"description2\":\"Example: What is the effectiveness of cognitive behavioral therapy compared to pharmacotherapy for treating major depressive disorder in adults?\"},{\"title\":\"AI Conducts Comprehensive Search (10-15 minutes)\",\"description\":\"Deep Research AI automatically searches across 200+ million papers using systematic methodology. It explores related concepts and MeSH terms for complete coverage.\"},{\"title\":\"Intelligent Study Screening\",\"description\":\"AI screens papers against your specific inclusion criteria, evaluating study design, population, interventions, and outcomes. Papers are ranked and filtered with transparent reasoning.\"},{\"title\":\"Automated Data Extraction for Meta-Analysis\",\"description\":\"Extract specific outcome measures, effect sizes, confidence intervals, and study characteristics across multiple studies in standardized tables for statistical analysis.\"},{\"title\":\"Compare Study Methodologies\",\"description\":\"Use Literature Review to extract and compare study designs, outcome measures, statistical methods, and risk of bias assessments across included studies.\"},{\"title\":\"Quality Assessment Support\",\"description\":\"AI evaluates study quality indicators and methodological rigor to support systematic quality assessment using established tools.\"}]},\"whoIsThisFor\":{\"heading\":\"Who Is This For?\",\"description\":\"Paperguide's AI Deep Research is designed for students, researchers, and professionals in academia, business, and industry who need to conduct comprehensive literature reviews and synthesize research findings quickly and efficiently.\",\"features\":[{\"title\":\"Evidence-Based Medicine Teams\",\"description\":\"conducting clinical systematic reviews for treatment guidelines and healthcare protocols\"},{\"title\":\"Academic Researchers\",\"description\":\"performing systematic reviews and meta-analyses for journal publications\"},{\"title\":\"Guideline Development Teams\",\"description\":\"synthesizing evidence for clinical practice guidelines and policy recommendations\"},{\"title\":\"Meta-analysis Specialists\",\"description\":\"extracting quantitative data across multiple studies for statistical synthesis\"},{\"title\":\"Healthcare Organizations\",\"description\":\"developing evidence-based protocols and treatment recommendations\"}]},\"productFeatures\":{\"heading\":\"Product Features\",\"features\":[{\"title\":\"Deep Research AI\",\"description\":\"Replace months of manual searching with automated systematic review generation and comprehensive analysis.\"},{\"title\":\"Literature Review\",\"description\":\"Build standardized extraction tables with consistent outcome measures and effect sizes for meta-analysis.\"},{\"title\":\"AI Search\",\"description\":\"Get immediate answers to specific review questions by analyzing multiple studies with synthesized citations.\"},{\"title\":\"Custom Data Extraction Columns\",\"description\":\"Design extraction forms matching systematic review protocols with PICO elements and statistical data.\"},{\"title\":\"SJR Rankings \u0026 Citation Metrics\",\"description\":\"Make informed inclusion decisions based on journal quality and research impact with objective metrics.\"},{\"title\":\"Chat with Papers\",\"description\":\"Ask questions directly to individual studies to understand methodological differences and outcome definitions.\"}]},\"faqs\":{\"heading\":\"Frequently Asked Questions\",\"items\":{\"faqItem1\":{\"question\":\"How does Paperguide ensure systematic review quality?\",\"answer\":\"Paperguide follows established systematic review guidelines and best practices. All screening decisions are transparent with documented reasoning, maintaining the methodological rigor required for high-quality systematic reviews.\"},\"faqItem2\":{\"question\":\"Can I use this for Cochrane reviews?\",\"answer\":\"Yes, Paperguide supports Cochrane review methodology including comprehensive searching, risk of bias assessment, and data extraction requirements. Many users successfully complete Cochrane protocols and reviews.\"},\"faqItem3\":{\"question\":\"How accurate is the AI screening compared to human reviewers?\",\"answer\":\"Our AI screening achieves 94-97% agreement with expert human reviewers in validation studies. The system prioritizes sensitivity to ensure relevant studies are not missed during screening.\"},\"faqItem4\":{\"question\":\"Does it handle different study designs for systematic reviews?\",\"answer\":\"Yes, Paperguide works with randomized controlled trials, quasi-experimental studies, observational studies, and other designs commonly included in systematic reviews and meta-analyses.\"},\"faqItem5\":{\"question\":\"Can I export data for statistical software?\",\"answer\":\"Yes, you can export extracted data in formats compatible with RevMan, R, Stata, and other statistical software commonly used for meta-analysis calculations.\"},\"faqItem6\":{\"question\":\"Can multiple reviewers collaborate on screening?\",\"answer\":\"You can share research reports and reference libraries with co-reviewers, enabling collaborative systematic review development with shared access to screening decisions and data extraction.\"}}}}}},\"deepsearch\":{\"updateDeepsearchTitle\":\"Update the title of your deep research\"},\"dashboard2\":{\"placeholderSearch\":\"Ask a research question or enter a topic...\",\"placeholderLiteratureReview\":\"Ask a question for a literature review. Add instructions if needed...\",\"placeholderDeepResearch\":\"Ask a question for a deep research report...\",\"greetingMessage\":\"What would you like to research today?\",\"logoutError\":\"Something went wrong while logging out\",\"pleaseEnterQuestion\":\"Please enter a question!\",\"pleaseLoginToContinue\":\"Please log in to continue\",\"selectReferencesError\":\"You selected \\\"Choose References\\\" as source. Please select some references to create a literature review.\",\"failedToCreateChat\":\"Failed to create chat\"}},\"children\":[\"$\",\"$L22\",null,{\"children\":[\"$\",\"$L23\",null,{\"children\":[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"d:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n8:null\n"])</script><script>self.__next_f.push([1,"b:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Paperguide: The AI Research Assistant\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Paperguide is an all-in-one AI Research Assistant to get research-backed answers, find \u0026 analyse research papers, manage references, and write documents\"}],[\"$\",\"meta\",\"2\",{\"name\":\"application-name\",\"content\":\"Paperguide\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"Paperguide\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://paperguide.ai/apple-touch-icon.png/\"}],[\"$\",\"link\",\"5\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://paperguide.ai/\"}],[\"$\",\"link\",\"6\",{\"rel\":\"alternate