Oss9" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/67e9eeb19d0cc4c32feb7410/js/webflow.536bb828.88fdea8bd1161532.js" type="text/javascript" integrity="sha384-hPTa551uqAwtLjXG8Uugvn96FBvFsdBv0lm6WZCmUyud4CkD+MuliuU4eDUmJS4q" crossorigin="anonymous"></script><script>
    // Check sessionStorage for banner display
    if (sessionStorage.getItem('banner') !== 'true') {
        document.getElementById("banner").style.display = 'flex';
    } else {
        document.getElementById('banner').style.display = "none";
    }

    // Add event listener to close button
    document.getElementById("closeButton").addEventListener("click", function() {
        // Set sessionStorage to 'true'
        sessionStorage.setItem('banner', 'true');
    });
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  /* Sélectionne tous les éléments .track-trial-click déjà présents dans le DOM */
  document.querySelectorAll('.track-trial-click').forEach(el => {
    el.addEventListener('click', () => {
      if (window.AhrefsAnalytics) {
        window.AhrefsAnalytics.sendEvent('trial_click');
      }
    });
  });
});
</script>

