<!--
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabPanes = document.querySelectorAll('.w-tab-pane');
    const iframeCache = new WeakMap(); // Stores clones of Lottie iframes

    function restartLottieIframe(iframe) {
      const originalSrc = iframe.src;
      if (!originalSrc) return;

      // Check if we've already cloned this iframe
      let cachedClone = iframeCache.get(iframe);

      if (!cachedClone) {
        cachedClone = iframe.cloneNode(); // Shallow clone
        cachedClone.src = originalSrc;    // Force reload of Lottie
        iframeCache.set(iframe, cachedClone); // Store clone for reuse
      }

      iframe.replaceWith(cachedClone);
    }

    function checkAndRestartLottie(pane) {
      if (pane.classList.contains('w--tab-active')) {
        const iframe = pane.querySelector('iframe[data-lottie]');
        if (iframe) {
          restartLottieIframe(iframe);
        }
      }
    }

    const observer = new MutationObserver(mutations => {
      mutations.forEach(mutation => {
        if (
          mutation.type === 'attributes' &&
          mutation.attributeName === 'class'
        ) {
          checkAndRestartLottie(mutation.target);
        }
      });
    });

    // Observe all tab panes and trigger check once on load
    tabPanes.forEach(pane => {
      observer.observe(pane, { attributes: true });
      checkAndRestartLottie(pane);
    });
  });
</script>
-->


<!--<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.10.2/lottie.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const lottiePlayers = new Map();

    function initLottieAnimations() {
      const allLottieDivs = document.querySelectorAll('[data-lottie-id]');

      allLottieDivs.forEach((lottieDiv) => {
        if (!lottiePlayers.has(lottieDiv) && lottieDiv.dataset.src) {
          const animation = lottie.loadAnimation({
            container: lottieDiv,
            renderer: "svg",
            loop: true,
            autoplay: false,
            path: lottieDiv.dataset.src,
          });
          lottiePlayers.set(lottieDiv, animation);
        }
      });
    }

    const tabPanes = document.querySelectorAll(".w-tab-pane");

    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === "attributes" && mutation.attributeName === "class") {
          const pane = mutation.target;
          if (pane.classList.contains("w--tab-active")) {
            const lottieDiv = pane.querySelector('[data-lottie-id]');
            if (lottieDiv && lottiePlayers.has(lottieDiv)) {
              const animation = lottiePlayers.get(lottieDiv);
              animation.goToAndStop(0, true);
              animation.play();
            }
          }
        }
      });
    });

    tabPanes.forEach((pane) => {
      observer.observe(pane, { attributes: true });
    });

    // Initialize Lotties
    initLottieAnimations();
    setTimeout(initLottieAnimations, 100); // handle late Webflow loads
  });
</script>
-->






<!--<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabPanes = document.querySelectorAll('.w-tab-pane');

    tabPanes.forEach(pane => {
      const iframe = pane.querySelector('iframe[data-lottie]');
      if (iframe && iframe.dataset.src) {
        // Create a hidden preloader iframe to preload the animation in advance
        const preloader = document.createElement('iframe');
        preloader.src = iframe.dataset.src;
        preloader.style.width = '0px';
        preloader.style.height = '0px';
        preloader.style.position = 'absolute';
        preloader.style.visibility = 'hidden';
        preloader.style.border = 'none';
        document.body.appendChild(preloader);

        // Store the source for later use
        iframe._originalSrc = iframe.dataset.src;

        // Optional: remove preloader after it's loaded
        preloader.onload = () => {
          setTimeout(() => {
            document.body.removeChild(preloader);
          }, 3000); // small delay to ensure it's cached
        };
      }
    });

    const observer = new MutationObserver((mutations) => {
      mutations.forEach(mutation => {
        if (
          mutation.type === 'attributes' &&
          mutation.attributeName === 'class'
        ) {
          const pane = mutation.target;
          if (pane.classList.contains('w--tab-active')) {
            const iframe = pane.querySelector('iframe[data-lottie]');
            if (iframe && iframe._originalSrc && !iframe.src) {
              // Set iframe src when tab becomes active
              iframe.src = iframe._originalSrc;
            }
          }
        }
      });
    });

    tabPanes.forEach(pane => {
      observer.observe(pane, { attributes: true });
    });
  });
</script>-->


<!--<script>
code for gifs animation
  document.addEventListener("DOMContentLoaded", function () {
    const tabPanes = document.querySelectorAll(".w-tab-pane");

    function restartGif(img) {
      const src = img.getAttribute("src").split("?")[0];
      // Add a unique timestamp to force reload
      img.setAttribute("src", src + "?t=" + new Date().getTime());
    }

    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === "attributes" && mutation.attributeName === "class") {
          const pane = mutation.target;
          if (pane.classList.contains("w--tab-active")) {
            const gif = pane.querySelector("img[data-gif]");
            if (gif) {
              restartGif(gif);
            }
          }
        }
      }
    });

    tabPanes.forEach((pane) => {
      observer.observe(pane, { attributes: true });
    });
  });
</script>-->
<!--<script src="https://player.vimeo.com/api/player.js"></script>
restarting vimeo video
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabPanes = document.querySelectorAll('.w-tab-pane');

    // Store Vimeo player instances by pane
    const vimeoPlayers = new Map();

    // Initialize Vimeo players and store them
    tabPanes.forEach(pane => {
      const iframe = pane.querySelector('iframe');
      if (iframe && iframe.src.includes('vimeo.com')) {
        const player = new Vimeo.Player(iframe);
        vimeoPlayers.set(pane, player);
      }
    });

    // Observe tab changes
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (
          mutation.type === 'attributes' &&
          mutation.attributeName === 'class'
        ) {
          const pane = mutation.target;

          if (pane.classList.contains('w--tab-active')) {
            const player = vimeoPlayers.get(pane);
            if (player) {
              player.setCurrentTime(0).then(() => {
                player.play(); // Restart from beginning and play
              });
            }
          } else {
            // Pause video in hidden tabs
            const player = vimeoPlayers.get(pane);
            if (player) {
              player.pause();
            }
          }
        }
      }
    });

    tabPanes.forEach(pane => observer.observe(pane, { attributes: true }));
  });
</script>

-->
