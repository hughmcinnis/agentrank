</svg></div></a><nav role="navigation" class="nav-menu w-nav-menu"><a href="/about" class="nav-link-new w-nav-link">About</a><a href="/security" class="nav-link-new w-nav-link">Security</a><a href="/blog" class="nav-link-new w-nav-link">Blog</a><a href="/careers" class="nav-link-new cc-last w-nav-link">Careers</a></nav><div class="menu-button w-nav-button"><div class="hamburger-icon top"></div><div class="hamburger-icon bottom"></div></div></div><div class="nav-bg"></div></div><div class="pop-up"><div class="popup-item"><div class="waitlist-form w-form"><form id="email-form" name="wf-form-Join-Waitlist" data-name="Join Waitlist" method="get" data-form="multistep" class="form-waitlist" data-wf-page-id="6758b94c1f0dc8ffe7f503b7" data-wf-element-id="0d174b77-e27f-6731-f914-4373912bb083"><div><div class="h2-new mb-10">Join the <span class="cc-italics">waitlist</span></div><div class="paragraph-s-new">Share your information to join our waitlist for access to Basis.</div></div><div data-form="step" class="data-step hide-temp"><div><label for="Name" class="text-eyebrow">Name</label><input class="popup-field w-input" maxlength="256" name="Name" data-name="Name" placeholder="" type="text" id="Name" required=""/></div><div><label for="Work-Email" class="text-eyebrow">Work Email</label><input class="popup-field sync w-input" maxlength="256" name="Work-Email" data-name="Work Email" placeholder="" type="email" id="Work-Email" required=""/></div><div><label for="Firm-Name" class="text-eyebrow">Name of Company</label><input class="popup-field w-input" maxlength="256" name="Firm-Name" data-name="Firm Name" placeholder="" type="text" id="Firm-Name" required=""/></div><div><label for="firm-size" class="text-eyebrow">What is the size of your company?</label><select id="firm-size" name="firm-size" data-name="firm-size" required="" class="popup-field w-select"><option value="solo">Solo practitioner</option><option value="2-10">2-10 employees</option><option value="11-50">11-50 employees</option><option value="51-100">51-100 employees</option><option value="100-or-more">100+ employees</option></select></div><div id="w-node-_0d174b77-e27f-6731-f914-4373912bb096-912bb080"><label for="use-case-for-basis" class="text-eyebrow">What will you use Basis for?<br/></label><select id="use-case-for-basis" name="use-case-for-basis" data-name="use-case-for-basis" required="" class="popup-field w-select"><option value="client-services">Client services accounting</option><option value="In-house">In house accounting</option><option value="tax">Tax preparation &amp; planning</option><option value="audit">Audit &amp; assurance</option><option value="other">Other</option></select></div></div><input type="submit" data-wait="" id="Submit" data-form="submit-btn" class="button-new cc-waitlist w-button" value="Submit"/><p class="paragraph-xs-new cc-italics max-w-750">We will use the information you provide to respond to your inquiry and communicate with you about our services. We do not sell or share personal information. For more information, see our <a href="/privacy-policy">Privacy Policy</a>.</p></form><div class="success-message w-form-done"><div><div class="mb-32"><div class="h2-new mb-10">You’re on our waitlist!</div><div class="paragraph-s-new">Our team will be in touch soon.</div></div><a data-w-id="9b4cf2e1-f894-f71f-13e6-e24c72540096" href="#">Close modal</a></div></div><div class="background-palegray w-form-fail"><div class="paragraph-s-new">Something went wrong while submitting the form. Please try again.</div></div></div><img loading="lazy" src="https://cdn.prod.website-files.com/6758b94c1f0dc8ffe7f503a7/6758b94c1f0dc8ffe7f503cb_9104213_close_cross_remove_delete_icon.svg" alt="" class="close-icon"/></div><div data-w-id="8e6d6954-e80a-8c97-6fc5-bcfe87227d0b" class="popup-close-bg"></div></div><div class="display-none w-embed w-script"><style>
html {
  overscroll-behavior-y: none;
}
.nav-bg {
  opacity: 0;
  transition: opacity 0.4s ease !important;
}
.nav-bg.visible {
  opacity: 1;
}
.nav-new {
  transform: translateY(0) !important;
  transition: transform 0.4s ease !important;
}
.nav-new.scrolled {
  transform: translateY(var(--banner-height, -40px)) !important;
}
.button-new {
  background-image: url("https://cdn.prod.website-files.com/6758b94c1f0dc8ffe7f503a7/6998ca9b00df693eb861a3de_right-arrow.svg");
  background-position: right 1rem center !important;
  background-size: auto;
  background-repeat: no-repeat;
}
@media (max-width: 991px) {
  .button-new {
    background-size: 25px !important;
  }
}
@media (max-width: 639px) {
  .button-new {
    background-size: 20px !important;
  }
}
.button-new.cc-down {
  background-image: url("https://cdn.prod.website-files.com/6758b94c1f0dc8ffe7f503a7/699b6cd698970f1019b12d2f_down-arrow.svg");
  background-position: right 1rem center !important;
  background-size: auto;
  background-repeat: no-repeat;
}
@media (max-width: 991px) {
  .button-new.cc-down {
    background-size: auto 25px !important;
  }
}
@media (max-width: 639px) {
  .button-new.cc-down {
    background-size: auto 20px !important;
  }
}
blockquote::first-letter {
  margin-left: -0.3em;
}
.rich-text > *:last-child {
  margin-bottom: 0;
}

/* Shared nav transitions */
.nav-logo,
.nav-link-new,
.hamburger-icon {
  transition: color 0.4s ease, filter 0.4s ease;
}

/* Dark mode — all sizes: logo white on load */
[data-wf--navbar-new--variant="dark-mode"] .nav-logo {
  filter: brightness(0) invert(1);
}

/* Dark mode — tablet and up: nav links white on load */
@media (min-width: 768px) {
  [data-wf--navbar-new--variant="dark-mode"] .nav-link-new {
    filter: brightness(0) invert(1);
  }
  /* On scroll, revert to black */
  [data-wf--navbar-new--variant="dark-mode"].scrolled .nav-logo,
  [data-wf--navbar-new--variant="dark-mode"].scrolled .nav-link-new {
    filter: brightness(0);
  }
}

/* Dark mode — below tablet */
@media (max-width: 767px) {
  /* Hamburger white on load */
  [data-wf--navbar-new--variant="dark-mode"] .hamburger-icon {
    filter: brightness(0) invert(1);
  }
  /* When menu is open, flip hamburger and logo to black */
  [data-wf--navbar-new--variant="dark-mode"].nav-menu-open .hamburger-icon,
  [data-wf--navbar-new--variant="dark-mode"].nav-menu-open .nav-logo {
    filter: brightness(0);
  }
  /* On scroll, revert logo and hamburger to black */
  [data-wf--navbar-new--variant="dark-mode"].scrolled .nav-logo,
  [data-wf--navbar-new--variant="dark-mode"].scrolled .hamburger-icon {
    filter: brightness(0);
  }
}
</style>
<script>
window.addEventListener('load', function () {
  const navBg  = document.querySelector('.nav-bg');
  const navNew = document.querySelector('.nav-new');

  function updateBannerHeight() {
    const banner = navNew ? navNew.querySelector('.nav-banner, [class*="banner"], [class*="announcement"]') : null;
    const height = banner ? banner.offsetHeight : (navNew ? navNew.querySelector(':first-child')?.offsetHeight ?? 40 : 40);
    document.documentElement.style.setProperty('--banner-height', `-${height}px`);
  }

  function onScroll() {
    if (window.scrollY > 0) {
      if (navBg)  navBg.classList.add('visible');
      if (navNew) navNew.classList.add('scrolled');
    } else {
      if (navBg)  navBg.classList.remove('visible');
      if (navNew) navNew.classList.remove('scrolled');
    }
  }

  // Watch for Webflow adding/removing w--open on the menu button
  const menuButton = document.querySelector('.menu-button');
  if (menuButton && navNew) {
    const observer = new MutationObserver(function () {
      if (menuButton.classList.contains('w--open')) {
        navNew.classList.add('nav-menu-open');
      } else {
        navNew.classList.remove('nav-menu-open');
      }
    });
    observer.observe(menuButton, { attributes: true, attributeFilter: ['class'] });
  }

  updateBannerHeight();
  window.addEventListener('resize', updateBannerHeight, { passive: true });
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Popup scroll lock — below tablet only (< 992px)
  const popup = document.querySelector('.pop-up');
  if (popup) {
    const popupObserver = new MutationObserver(() => {
      const isMobile = window.innerWidth < 992;
      const isVisible =
        popup.style.display !== 'none' &&
        !popup.classList.contains('w-condition-invisible') &&
        popup.offsetParent !== null;

      if (isVisible && isMobile) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    popupObserver.observe(popup, {
      attributes: true,
      attributeFilter: ['style', 'class'],
    });
  }
});
